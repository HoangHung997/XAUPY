<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XAUPY.Desktop"
             x:Class="XAUPY.Desktop.BacktestDashboard">
  <UserControl.Styles>
    <Style Selector="Grid.kpiCards TextBlock.label"><Setter Property="FontSize" Value="{DynamicResource Font_13}"/></Style>
    <Style Selector="Grid.resultActions Button"><Setter Property="Padding" Value="10,4"/><Setter Property="Height" Value="30"/><Setter Property="FontSize" Value="{DynamicResource Font_13}"/></Style>
    <Style Selector="TextBlock.btHeader">
      <Setter Property="Foreground" Value="{DynamicResource Brush_BED3E8}"/>
      <Setter Property="FontSize" Value="{DynamicResource Font_11}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,0,5,0"/>
    </Style>
    <Style Selector="Button.btRow">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.btRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource Brush_0A2844}"/>
    </Style>
    <Style Selector="Button.btAction">
      <Setter Property="Background" Value="{DynamicResource Brush_0A2E50}"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush_D8EBFF}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush_1D6396}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="FontSize" Value="{DynamicResource Font_10}"/>
    </Style>
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="8">
      <!-- Approved Backtest configuration zone -->
      <Border Classes="panel">
        <Grid RowDefinitions="32,Auto">
          <Border Grid.Row="0" Background="{DynamicResource Brush_082038}" Padding="12,7">
            <TextBlock Text="{DynamicResource Text_9a6f5e3a8bddc6fa}" Classes="panelTitle"/>
          </Border>

          <Grid Grid.Row="1"
                ColumnDefinitions="1.05*,0.95*,0.95*,0.95*,1.3*,0.78*,0.82*,1.0*"
                ColumnSpacing="8"
                Margin="12,6,12,8">
            <StackPanel Grid.Column="0" Spacing="3">
              <TextBlock Text="Symbol" Classes="label"/>
              <Border Classes="panelSoft" Padding="10,5">
                <TextBlock x:Name="BacktestSymbolText" Text="XAUUSD"/>
              </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="3">
              <TextBlock Text="{DynamicResource Text_5c8a102271043192}" Classes="label" ToolTip.Tip="{DynamicResource Text_bcc7252aaa9f7a37}"/>
              <TextBlock x:Name="BacktestTimeframeText" Text="{local:InitialText 4d4f94d591d94579}" VerticalAlignment="Center" ToolTip.Tip="{DynamicResource Text_254e71805e8c3e94}"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Spacing="3">
              <TextBlock Text="{DynamicResource Text_695f892aecf7e875}" Classes="label"/>
              <TextBox x:Name="BacktestFromDateBox" Text="2024-01-01"/>
            </StackPanel>

            <StackPanel Grid.Column="3" Spacing="3">
              <TextBlock Text="{DynamicResource Text_d650a93468b83cb5}" Classes="label"/>
              <TextBox x:Name="BacktestToDateBox" Text="2024-01-31"/>
            </StackPanel>

            <StackPanel Grid.Column="4" Spacing="3">
              <TextBlock Text="Model" Classes="label"/>
              <ComboBox x:Name="BacktestModelCombo" SelectedIndex="0">
                <ComboBoxItem Content="{DynamicResource Text_0a1f76228ec40bcc}"/>
                <ComboBoxItem Content="M1 OHLC" ToolTip.Tip="{DynamicResource Text_6270b7886a32136d}"/>
                <ComboBoxItem Content="{DynamicResource Text_76f246720a934bc0}" ToolTip.Tip="{DynamicResource Text_dc47805aa12690c8}"/>
              </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="5" Spacing="3">
              <TextBlock Text="Spread (point)" Classes="label"/>
              <TextBox x:Name="BacktestSpreadBox" Text="20"/>
            </StackPanel>

            <StackPanel Grid.Column="6" Spacing="3">
              <TextBlock Text="{DynamicResource Text_ad008883bfdcec6f}" Classes="label"/>
              <TextBox x:Name="BacktestCommissionBox" Text="7.00"/>
            </StackPanel>

            <Button x:Name="RunBacktestButton"
                    Grid.Column="7"
                    Classes="primary"
                    Content="{DynamicResource Text_8292e40a0a8e99aa}"
                    VerticalAlignment="Bottom"
                    MinHeight="38"
                    Click="RunBacktest_OnClick"/>
          </Grid>


        </Grid>
      </Border>

      <!-- Result title/actions -->
      <Border Classes="panel">
        <Grid Classes="resultActions" ColumnDefinitions="*,Auto" Margin="12,3">
          <TextBlock x:Name="BacktestResultHeaderText"
                     Text="{local:InitialText 4dfb7d85b62c476e}"
                     FontSize="{DynamicResource Font_16}"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <Button x:Name="CancelBacktestButton" Classes="secondary" Content="{DynamicResource Text_a116e0bfe0d31497}"
                    IsEnabled="False" Click="CancelBacktest_OnClick"/>
            <Button Classes="secondary"
                    Content="{DynamicResource Text_30af933e9b6e0912}"
                    Click="CompareResults_OnClick"
                    ToolTip.Tip="{DynamicResource Text_e8398a51d4b4e7a5}"/>
            <Button Classes="secondary"
                    Content="{DynamicResource Text_9fed9f813f7b7365}"
                    Click="ExportReport_OnClick"/>
            <Button Classes="secondary"
                    Content="{DynamicResource Text_54d4e133c5a1cea9}"
                    Click="SaveResult_OnClick"/>
            <Button Classes="secondary"
                    Content="{DynamicResource Text_d59cbfd1904f451e}"
                    Click="LoadDataset_OnClick"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Approved six KPI cards -->
      <Grid Classes="kpiCards" ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="8">
        <Border Grid.Column="0" Background="{DynamicResource Brush_062D24}" BorderBrush="{DynamicResource Brush_08A86D}" BorderThickness="1" CornerRadius="5" Padding="10">
          <Grid ColumnDefinitions="48,*">
            <Border Width="42" Height="42" CornerRadius="21" BorderBrush="{DynamicResource Brush_15D98B}" BorderThickness="2">
              <TextBlock Text="$" Foreground="{DynamicResource Brush_19E58C}" FontSize="{DynamicResource Font_25}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
              <TextBlock Text="{DynamicResource Text_bcf512fa299d15ef}" Classes="label"/>
              <TextBlock x:Name="NetProfitText" Text="—" FontSize="{DynamicResource Font_21}" FontWeight="Bold" Foreground="{DynamicResource Brush_18E58B}"/>
              <TextBlock x:Name="NetProfitPctText" Text="—" FontSize="{DynamicResource Font_13}" Foreground="{DynamicResource Brush_18E58B}"/>
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Column="1" Background="{DynamicResource Brush_06233E}" BorderBrush="{DynamicResource Brush_0B74D6}" BorderThickness="1" CornerRadius="5" Padding="10">
          <Grid ColumnDefinitions="48,*">
            <Border Width="42" Height="42" CornerRadius="21" BorderBrush="{DynamicResource Brush_258DF1}" BorderThickness="2">
              <TextBlock Text="↗" Foreground="{DynamicResource Brush_6DB9FF}" FontSize="{DynamicResource Font_24}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
              <TextBlock Text="{DynamicResource Text_1648715d7c160fac}" Classes="label"/>
              <TextBlock x:Name="WinRateText" Text="—" FontSize="{DynamicResource Font_21}" FontWeight="Bold" Foreground="{DynamicResource Brush_6DB9FF}"/>
              <TextBlock x:Name="WinDetailText" Text="—" FontSize="{DynamicResource Font_13}" Classes="dim"/>
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Column="2" Background="{DynamicResource Brush_21163A}" BorderBrush="{DynamicResource Brush_7344C2}" BorderThickness="1" CornerRadius="5" Padding="10">
          <Grid ColumnDefinitions="48,*">
            <Border Width="42" Height="42" CornerRadius="21" BorderBrush="{DynamicResource Brush_A36BFF}" BorderThickness="2">
              <TextBlock Text="▤" Foreground="{DynamicResource Brush_B98CFF}" FontSize="{DynamicResource Font_22}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
              <TextBlock Text="Profit Factor" Classes="label"/>
              <TextBlock x:Name="ProfitFactorText" Text="—" FontSize="{DynamicResource Font_21}" FontWeight="Bold" Foreground="{DynamicResource Brush_BB8BFF}"/>
              <TextBlock Text="{DynamicResource Text_c7010640708d3aec}" FontSize="{DynamicResource Font_12}" Classes="dim"/>
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Column="3" Background="{DynamicResource Brush_351321}" BorderBrush="{DynamicResource Brush_D92F4B}" BorderThickness="1" CornerRadius="5" Padding="10">
          <Grid ColumnDefinitions="48,*">
            <Border Width="42" Height="42" CornerRadius="21" BorderBrush="{DynamicResource Brush_FF3F5C}" BorderThickness="2">
              <TextBlock Text="⌁" Foreground="{DynamicResource Brush_FF526C}" FontSize="{DynamicResource Font_23}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
              <TextBlock Text="{DynamicResource Text_169ec52d0328d90d}" Classes="label"/>
              <TextBlock x:Name="DrawdownPctText" Text="—" FontSize="{DynamicResource Font_21}" FontWeight="Bold" Foreground="{DynamicResource Brush_FF526C}"/>
              <TextBlock x:Name="DrawdownUsdText" Text="—" FontSize="{DynamicResource Font_13}" Foreground="{DynamicResource Brush_FF6C82}"/>
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Column="4" Background="{DynamicResource Brush_06283C}" BorderBrush="{DynamicResource Brush_0D85B6}" BorderThickness="1" CornerRadius="5" Padding="10">
          <Grid ColumnDefinitions="48,*">
            <Border Width="42" Height="42" CornerRadius="21" BorderBrush="{DynamicResource Brush_21B9E8}" BorderThickness="2">
              <TextBlock Text="☷" Foreground="{DynamicResource Brush_53D7FF}" FontSize="{DynamicResource Font_22}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
              <TextBlock Text="{DynamicResource Text_5627b53ece48513d}" Classes="label"/>
              <TextBlock x:Name="TotalTradesText" Text="—" FontSize="{DynamicResource Font_21}" FontWeight="Bold" Foreground="{DynamicResource Brush_53D7FF}"/>
              <TextBlock Text="{DynamicResource Text_2c0dfc72057506fc}" FontSize="{DynamicResource Font_12}" Classes="dim"/>
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Column="5" Background="{DynamicResource Brush_332A0D}" BorderBrush="{DynamicResource Brush_9A7A17}" BorderThickness="1" CornerRadius="5" Padding="10">
          <Grid ColumnDefinitions="48,*">
            <Border Width="42" Height="42" CornerRadius="21" BorderBrush="{DynamicResource Brush_D6A82A}" BorderThickness="2">
              <TextBlock Text="≈" Foreground="{DynamicResource Brush_FFD04B}" FontSize="{DynamicResource Font_28}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
              <TextBlock Text="{DynamicResource Text_67a6021f1687b47f}" Classes="label"/>
              <TextBlock x:Name="AverageTradeText" Text="—" FontSize="{DynamicResource Font_21}" FontWeight="Bold" Foreground="{DynamicResource Brush_FFD04B}"/>
              <TextBlock x:Name="AverageTradePctText" Text="—" FontSize="{DynamicResource Font_13}" Classes="dim"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <!-- Equity + drawdown -->
      <Grid ColumnDefinitions="1.05*,1*" ColumnSpacing="8">
        <Border Grid.Column="0" Classes="panel" Height="260">
          <Grid RowDefinitions="36,*,24">
            <Grid Grid.Row="0" Background="{DynamicResource Brush_082038}" ColumnDefinitions="*,Auto" Margin="0">
              <TextBlock Text="{DynamicResource Text_60201f2289d9a84b}" Classes="panelTitle" Margin="12,8"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" Margin="0,4,8,4">
                <Border Classes="panelSoft" Padding="10,4"><TextBlock Text="Balance" FontSize="{DynamicResource Font_12}"/></Border>
                <Border Background="{DynamicResource Brush_0866F4}" CornerRadius="4" Padding="10,4"><TextBlock Text="Equity" FontSize="{DynamicResource Font_12}"/></Border>
                <Border Classes="panelSoft" Padding="10,4"><TextBlock Text="{DynamicResource Text_0df37728ad393b0c}" FontSize="{DynamicResource Font_12}"/></Border>
              </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="10,6">
              <local:BacktestChartControl x:Name="EquityChart"/>
              <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="8,5">
                <TextBlock Text="— Balance" Foreground="{DynamicResource Brush_30D08A}" FontSize="{DynamicResource Font_12}"/>
                <TextBlock Text="— Equity" Foreground="{DynamicResource Brush_1B8FFF}" FontSize="{DynamicResource Font_12}"/>
              </StackPanel>
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="12,0">
              <TextBlock x:Name="EquityRangeText" Text="Range: —" Classes="dim" FontSize="{DynamicResource Font_12}"/>
              <TextBlock x:Name="EquityLastText" Grid.Column="1" Text="Last: —" Foreground="{DynamicResource Brush_67B9FF}" FontSize="{DynamicResource Font_12}"/>
            </Grid>
          </Grid>
        </Border>

        <Border Grid.Column="1" Classes="panel" Height="260">
          <Grid RowDefinitions="36,*,24">
            <Grid Grid.Row="0" Background="{DynamicResource Brush_082038}" ColumnDefinitions="*,Auto">
              <TextBlock Text="{DynamicResource Text_96e541405d30d5af}" Classes="panelTitle" Margin="12,8"/>
              <ComboBox Grid.Column="1" Width="150" SelectedIndex="0" IsEnabled="False" Margin="0,4,8,4">
                <ComboBoxItem Content="{DynamicResource Text_02fde5e3de280156}"/>
              </ComboBox>
            </Grid>

            <Grid Grid.Row="1" Margin="10,6">
              <local:BacktestChartControl x:Name="DrawdownChart"/>
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="12,0">
              <TextBlock Text="0% → Max DD" Classes="dim" FontSize="{DynamicResource Font_12}"/>
              <TextBlock x:Name="DrawdownRangeText" Grid.Column="1" Text="Max: —" Foreground="{DynamicResource Brush_FF526C}" FontSize="{DynamicResource Font_12}"/>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <!-- History + trade list -->
      <Grid ColumnDefinitions="1.35*,1*" ColumnSpacing="8">
        <Border Grid.Column="0" Classes="panel" MinHeight="254">
          <Grid RowDefinitions="36,Auto,*,44">
            <Border Grid.Row="0" Background="{DynamicResource Brush_082038}" Padding="12,8">
              <TextBlock Text="{DynamicResource Text_1f03c3238508e6af}" Classes="panelTitle"/>
            </Border>

            <Grid Grid.Row="1"
                  ColumnDefinitions="0.34*,1.38*,0.72*,0.52*,0.88*,0.88*,1*,0.82*,0.6*,0.74*,0.7*,0.8*"
                  Margin="8,6,8,3">
              <TextBlock Text="#" Classes="btHeader"/>
              <TextBlock Grid.Column="1" Text="{DynamicResource Text_c0bb553f31237883}" Classes="btHeader"/>
              <TextBlock Grid.Column="2" Text="Symbol" Classes="btHeader"/>
              <TextBlock Grid.Column="3" Text="TF" Classes="btHeader"/>
              <TextBlock Grid.Column="4" Text="{DynamicResource Text_695f892aecf7e875}" Classes="btHeader"/>
              <TextBlock Grid.Column="5" Text="{DynamicResource Text_d650a93468b83cb5}" Classes="btHeader"/>
              <TextBlock Grid.Column="6" Text="{DynamicResource Text_bcf512fa299d15ef}" Classes="btHeader"/>
              <TextBlock Grid.Column="7" Text="{DynamicResource Text_bbbae258f14c7fb3}" Classes="btHeader"/>
              <TextBlock Grid.Column="8" Text="PF" Classes="btHeader"/>
              <TextBlock Grid.Column="9" Text="{DynamicResource Text_1648715d7c160fac}" Classes="btHeader"/>
              <TextBlock Grid.Column="10" Text="{DynamicResource Text_eca31d98e6a0d9a5}" Classes="btHeader"/>
              <TextBlock Grid.Column="11" Text="{DynamicResource Text_cb31de8160c9d623}" Classes="btHeader"/>
            </Grid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="BacktestHistoryRowsHost" Margin="6,0,6,4"/>
            </ScrollViewer>

            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="10,2,10,4">
              <TextBlock x:Name="HistoryCountText" Text="{local:InitialText eaf8fd8c9ca9f33e}" Classes="dim" FontSize="{DynamicResource Font_12}" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Classes="secondary" Content="{DynamicResource Text_d6fafb3017013271}" Click="RefreshHistory_OnClick"/>
                <Button Classes="secondary" Content="{DynamicResource Text_21af1018b2d15693}" Click="ViewSelectedHistory_OnClick"/>
                <Button Background="{DynamicResource Brush_351321}" BorderBrush="{DynamicResource Brush_D92F4B}" BorderThickness="1" CornerRadius="4" Foreground="{DynamicResource Brush_FF6379}" Content="{DynamicResource Text_8c264171aa90795b}" Click="DeleteSelectedHistory_OnClick"/>
              </StackPanel>
            </Grid>
          </Grid>
        </Border>

        <Border Grid.Column="1" Classes="panel" MinHeight="254">
          <Grid RowDefinitions="36,Auto,*,44">
            <Grid Grid.Row="0" Background="{DynamicResource Brush_082038}" ColumnDefinitions="*,Auto">
              <TextBlock Text="{DynamicResource Text_8e48d5dfb621aa5f}" Classes="panelTitle" Margin="12,8"/>
              <TextBlock x:Name="TradeFilterText" Grid.Column="1" Text="{local:InitialText 49c73a3150d77038}" Classes="dim" VerticalAlignment="Center" Margin="0,0,12,0"/>
            </Grid>

            <Grid Grid.Row="1"
                  ColumnDefinitions="0.34*,1.35*,0.58*,0.52*,0.88*,0.88*,0.82*,0.86*,0.6*"
                  Margin="8,6,8,3">
              <TextBlock Text="#" Classes="btHeader"/>
              <TextBlock Grid.Column="1" Text="{DynamicResource Text_b295fd620d82e277}" Classes="btHeader"/>
              <TextBlock Grid.Column="2" Text="{DynamicResource Text_3bfbf92340103cf7}" Classes="btHeader"/>
              <TextBlock Grid.Column="3" Text="Lot" Classes="btHeader"/>
              <TextBlock Grid.Column="4" Text="{DynamicResource Text_dd9aa148e58dcd46}" Classes="btHeader"/>
              <TextBlock Grid.Column="5" Text="{DynamicResource Text_1946533c33f349bb}" Classes="btHeader"/>
              <TextBlock Grid.Column="6" Text="{DynamicResource Text_bf783ab732e8e763}" Classes="btHeader"/>
              <TextBlock Grid.Column="7" Text="{DynamicResource Text_b590663e05b2e26d}" Classes="btHeader"/>
              <TextBlock Grid.Column="8" Text="{DynamicResource Text_1a51692b3430fb20}" Classes="btHeader"/>
            </Grid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="BacktestTradeRowsHost" Margin="6,0,6,4"/>
            </ScrollViewer>

            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="10,2,10,4">
              <TextBlock x:Name="TradePageSummaryText" Text="{local:InitialText f234bec042bf81ed}" Classes="dim" FontSize="{DynamicResource Font_12}" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                <Button x:Name="PrevTradePageButton" Classes="secondary" Content="‹" Click="PrevTradePage_OnClick"/>
                <TextBlock x:Name="TradePageText" Text="1 / 1" VerticalAlignment="Center" Margin="6,0"/>
                <Button x:Name="NextTradePageButton" Classes="secondary" Content="›" Click="NextTradePage_OnClick"/>
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
      </Grid>
      <Expander Header="{DynamicResource Text_a4c8fcc24bfeb753}" HorizontalAlignment="Stretch">
          <Grid ColumnDefinitions="*,Auto,Auto" Margin="12,6,12,10">
            <TextBlock x:Name="DatasetStatusText"
                       Text="{local:InitialText f9dff25100421508}"
                       Classes="dim"
                       FontSize="{DynamicResource Font_12}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="12,0">
              <TextBlock Text="{DynamicResource Text_61f2e1dc415de7c4}" Classes="dim" FontSize="{DynamicResource Font_12}" VerticalAlignment="Center"/>
              <TextBox x:Name="InitialBalanceBox" Width="110" Height="24" Text="10000"/>
            </StackPanel>
            <TextBlock x:Name="BacktestRunStatusText"
                       Grid.Column="2"
                       Text="{local:InitialText c4374806771a5cd5}"
                       Foreground="{DynamicResource Brush_FFD34D}"
                       FontSize="{DynamicResource Font_12}"
                       VerticalAlignment="Center"/>
          </Grid>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
