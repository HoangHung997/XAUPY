<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="XAUPY.Desktop.ConfigurationEditor">
  <UserControl.Styles>
    <Style Selector="Button.navTab"><Setter Property="Margin" Value="0"/><Setter Property="Height" Value="53"/><Setter Property="Padding" Value="12,6"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
    <Style Selector="Button.configToolbar"><Setter Property="Padding" Value="12,5"/><Setter Property="FontSize" Value="14"/><Setter Property="MinHeight" Value="30"/></Style>
  </UserControl.Styles>
  <Grid ColumnDefinitions="274,*" ColumnSpacing="10">
    <!-- Approved configuration category rail -->
    <Border Grid.Column="0" Classes="panel">
      <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Background="#082038" Padding="12,8">
          <TextBlock Text="Danh mục cấu hình" Classes="panelTitle"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="8" Spacing="0">
            <Button Classes="navTab active" HorizontalContentAlignment="Left" Tag="risk" Click="Category_OnClick">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="🛡" FontSize="18"/><StackPanel><TextBlock Text="Khởi tạo &amp; an toàn" FontWeight="SemiBold"/><TextBlock Text="Tài khoản, lot, rủi ro, giới hạn" Classes="dim" FontSize="12"/></StackPanel></StackPanel>
            </Button>
            <Button Classes="navTab" HorizontalContentAlignment="Left" Tag="direction" Click="Category_OnClick">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="⇄" FontSize="18"/><StackPanel><TextBlock Text="Hướng giao dịch" FontWeight="SemiBold"/><TextBlock Text="Chỉ buy/sell hoặc 2 chiều" Classes="dim" FontSize="12"/></StackPanel></StackPanel>
            </Button>
            <Button Classes="navTab" HorizontalContentAlignment="Left" Tag="pullback" Click="Category_OnClick">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="⌁" FontSize="18"/><StackPanel><TextBlock Text="Nhận diện nhịp hồi" FontWeight="SemiBold"/><TextBlock Text="Pullback &amp; điều kiện hồi" Classes="dim" FontSize="12"/></StackPanel></StackPanel>
            </Button>
            <Button Classes="navTab" HorizontalContentAlignment="Left" Tag="trigger" Click="Category_OnClick">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="✓" FontSize="18"/><StackPanel><TextBlock Text="Xác nhận vào lệnh" FontWeight="SemiBold"/><TextBlock Text="Chỉ báo &amp; tín hiệu trigger" Classes="dim" FontSize="12"/></StackPanel></StackPanel>
            </Button>
            <Button Classes="navTab" HorizontalContentAlignment="Left" Tag="stop_loss" Click="Category_OnClick">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="🛡" FontSize="18"/><StackPanel><TextBlock Text="Stop loss" FontWeight="SemiBold"/><TextBlock Text="SL structure / fixed / ATR" Classes="dim" FontSize="12"/></StackPanel></StackPanel>
            </Button>
            <Button Classes="navTab" HorizontalContentAlignment="Left" Tag="take_profit" Click="Category_OnClick">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="◎" FontSize="18"/><StackPanel><TextBlock Text="Take profit" FontWeight="SemiBold"/><TextBlock Text="TP fixed / dynamic" Classes="dim" FontSize="12"/></StackPanel></StackPanel>
            </Button>
            <Button Classes="navTab" HorizontalContentAlignment="Left" Tag="management" Click="Category_OnClick">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="⚙" FontSize="18"/><StackPanel><TextBlock Text="Quản lý sau vào" FontWeight="SemiBold"/><TextBlock Text="BE, trailing, scale out" Classes="dim" FontSize="12"/></StackPanel></StackPanel>
            </Button>
            <Button Classes="navTab" HorizontalContentAlignment="Left" Tag="sessions" Click="Category_OnClick">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="◷" FontSize="18"/><StackPanel><TextBlock Text="Phiên giao dịch" FontWeight="SemiBold"/><TextBlock Text="Khung giờ, bộ lọc phiên" Classes="dim" FontSize="12"/></StackPanel></StackPanel>
            </Button>
            <Button Classes="navTab" HorizontalContentAlignment="Left" Tag="news" Click="Category_OnClick">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="▤" FontSize="18"/><StackPanel><TextBlock Text="Lọc tin" FontWeight="SemiBold"/><TextBlock Text="Tin tức, thời gian tránh giao dịch" Classes="dim" FontSize="12"/></StackPanel></StackPanel>
            </Button>
            <Button Classes="navTab" HorizontalContentAlignment="Left" Tag="pullback" Click="Category_OnClick">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="▱" FontSize="18"/><StackPanel><TextBlock Text="MTF Pullback" FontWeight="SemiBold"/><TextBlock Text="Đa khung thời gian - Pullback" Classes="dim" FontSize="12"/></StackPanel></StackPanel>
            </Button>
            <Button Classes="navTab" HorizontalContentAlignment="Left" Tag="trigger" Click="Category_OnClick">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="▱" FontSize="18"/><StackPanel><TextBlock Text="MTF Trigger" FontWeight="SemiBold"/><TextBlock Text="Đa khung thời gian - Trigger" Classes="dim" FontSize="12"/></StackPanel></StackPanel>
            </Button>
          </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Classes="panelSoft" Margin="8" Padding="10">
          <StackPanel Spacing="5">
            <TextBlock Text="Cấu hình hiện tại" FontWeight="SemiBold"/>
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Text="Profile:" Classes="dim"/><TextBlock x:Name="ProfileNameText" Grid.Column="1" Text="—" Foreground="#18E58B" Margin="8,0,0,0"/>
            </Grid>
            <TextBlock x:Name="DirtyStateText" Text="UNCHANGED" Foreground="#18E58B" FontSize="12"/>
            <TextBlock x:Name="ValidationStateText" Text="NOT VALIDATED" Foreground="#FFD34D" FontSize="12"/>
            <TextBlock x:Name="FieldCountText" Text="0 tham số" Classes="dim" FontSize="12"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="86,*" RowSpacing="8">
      <!-- Approved profile/header toolbar -->
      <Border Grid.Row="0" Classes="panel">
        <Grid ColumnDefinitions="1.35*,0.8*,Auto" Margin="12,8" ColumnSpacing="10">
          <StackPanel>
            <TextBlock Text="Cấu hình chiến lược giao dịch" FontSize="21" FontWeight="SemiBold"/>
            <TextBlock Text="Thiết lập đầy đủ thông số cho hệ thống giao dịch tự động - XAUUSD" Classes="dim" FontSize="13"/><TextBox x:Name="SearchBox" PlaceholderText="Tìm tham số…" FontSize="12" Width="280" HorizontalAlignment="Left" Margin="0,3,0,0" Height="24" MinHeight="24" Padding="7,2" TextChanged="SearchBox_OnTextChanged"/>
          </StackPanel>

          <StackPanel Grid.Column="1">
            <TextBlock Text="Chọn profile" Classes="dim" FontSize="12"/>
            <Border Classes="panelSoft" Padding="10,7">
              <TextBlock x:Name="ProfileHeaderText" Text="Active profile từ Python Engine"/>
            </Border>
          </StackPanel>

          <WrapPanel Grid.Column="2" Width="420" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button Classes="primary configToolbar" Content="💾  Lưu JSON" Click="SaveJson_OnClick" Margin="0,0,6,6"/>
            <Button Classes="secondary configToolbar" Content="💾  Lưu thành..." Click="SaveJson_OnClick" Margin="0,0,6,6"/>
            <Button Classes="secondary configToolbar" Content="🗑  Mặc định" Click="Defaults_OnClick" Margin="0,0,6,6"/>
            <Button Classes="secondary configToolbar" Content="⬆  Nhập JSON" Click="LoadJson_OnClick" Margin="0,0,6,6"/>
            <Button Classes="secondary configToolbar" Content="⬇  Xuất .set" Click="ExportSet_OnClick" Margin="0,0,6,6"/>
            <Button Classes="secondary configToolbar" Content="⬆  Nhập .set" Click="ImportSet_OnClick" Margin="0,0,0,6"/>
          </WrapPanel>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="FieldsHost" ColumnDefinitions="*,*,*,*,*,*,*,*,*,*,*,*" ColumnSpacing="8" RowSpacing="8" Margin="0,0,4,8">
          <Border x:Name="ValidationCard" Grid.Row="3" Grid.Column="8" Grid.ColumnSpan="4" Classes="panel" Padding="10,8">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
              <Grid ColumnDefinitions="*,Auto"><TextBlock Text="✓  Kiểm tra &amp; Xác thực cấu hình" FontSize="16" FontWeight="SemiBold" Foreground="#00DCB6"/><TextBlock Grid.Column="1" x:Name="VisibleCountText" Text="0 / 0" FontSize="11" Classes="dim"/></Grid>
              <StackPanel Grid.Row="1" Spacing="7"><TextBlock x:Name="StatusText" Text="Đang chờ Python Engine..." FontSize="13" Foreground="#C9DDEF" TextWrapping="Wrap"/><TextBlock Text="TÀI KHOẢN THẬT ĐANG KHÓA" Foreground="#FFD34D" FontSize="12"/><StackPanel IsVisible="False"><TextBlock x:Name="DirectionQuickValue"/><TextBlock x:Name="PullbackQuickValue"/><TextBlock x:Name="TriggerQuickValue"/></StackPanel></StackPanel>
              <Grid Grid.Row="2" ColumnDefinitions="1.3*,1*,0.65*" ColumnSpacing="6"><Button Classes="primary" Content="▶ Áp dụng cấu hình" Click="Apply_OnClick" Padding="8,6"/><Button Grid.Column="1" Classes="secondary" Content="↻ Kiểm tra lại" Click="Validate_OnClick" Padding="8,6"/><Button Grid.Column="2" Classes="secondary" Content="Hoàn tác" Click="ReloadActive_OnClick" FontSize="12" Padding="4,6"/></Grid>
            </Grid>
          </Border>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
