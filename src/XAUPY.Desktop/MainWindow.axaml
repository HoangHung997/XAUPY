<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:XAUPY.Desktop"
        x:Class="XAUPY.Desktop.MainWindow"
        Width="1672"
        Height="941"
        MinWidth="1360"
        MinHeight="780"
        WindowStartupLocation="CenterScreen"
        Background="#031426"
        WindowDecorations="None"
        Title="N30 Control Center v1.0 (Python) - XAUUSD">

  <Grid RowDefinitions="42,82,*,24">
    <!-- Custom title bar: mirrors the approved N30 mockup -->
    <Border Grid.Row="0"
            Background="#03162A"
            BorderBrush="#124467"
            BorderThickness="0,0,0,1"
            PointerPressed="TitleBar_OnPointerPressed">
      <Grid ColumnDefinitions="*,Auto,Auto" Margin="14,0,6,0">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Width="22" Height="22" CornerRadius="11" Background="#0877FF">
            <TextBlock Text="N30" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="N30 Control Center" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock Text="v1.0 (Python)  -  XAUUSD" FontSize="18" FontWeight="SemiBold" Foreground="#D8E6F7" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,18,0">
          <TextBlock x:Name="HeaderBridgePillText" Text="●  Waiting for MT5" Foreground="#FFD34D" FontSize="15" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
          <Button Width="42" Background="Transparent" BorderThickness="0" Foreground="#C9D9EA" Content="—" Click="Minimize_OnClick"/>
          <Button Width="42" Background="Transparent" BorderThickness="0" Foreground="#C9D9EA" Content="□" Click="Maximize_OnClick"/>
          <Button Width="42" Background="Transparent" BorderThickness="0" Foreground="#C9D9EA" Content="✕" Click="Close_OnClick"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Approved horizontal navigation -->
    <Border Grid.Row="1" Background="#04172A" BorderBrush="#14517A" BorderThickness="1" Margin="14,2,14,8" CornerRadius="6">
      <Grid ColumnDefinitions="*,*,*,*,*,*,*,*,*,*,175">
        <Button x:Name="NavOverview" Grid.Column="0" Classes="navTab active" Tag="overview" Click="NavButton_OnClick">
          <StackPanel Spacing="7"><Path Width="23" Height="23" Stretch="Uniform" Stroke="#E2EEFF" StrokeThickness="1.35" Data="M2 11 L12 2 L22 11 M5 9 V22 H10 V15 H14 V22 H19 V9" HorizontalAlignment="Center"/><TextBlock Text="Tổng quan" FontSize="16"/></StackPanel>
        </Button>
        <Button x:Name="NavConfiguration" Grid.Column="1" Classes="navTab" Tag="configuration" Click="NavButton_OnClick">
          <StackPanel Spacing="7"><Path Width="23" Height="23" Stretch="Uniform" Stroke="#E2EEFF" StrokeThickness="1.35" Data="M9 2 H15 L16 6 L20 7 L22 12 L20 17 L16 18 L15 22 H9 L8 18 L4 17 L2 12 L4 7 L8 6 Z M12 8 A4 4 0 1 0 12 16 A4 4 0 1 0 12 8" HorizontalAlignment="Center"/><TextBlock Text="Cấu hình" FontSize="16"/></StackPanel>
        </Button>
        <Button x:Name="NavStrategy" Grid.Column="2" Classes="navTab" Tag="strategy" Click="NavButton_OnClick">
          <StackPanel Spacing="7"><Path Width="23" Height="23" Stretch="Uniform" Stroke="#E2EEFF" StrokeThickness="1.35" Data="M3 22 V14 M8 22 V7 M13 22 V2 M18 22 V10 M23 22 V5" HorizontalAlignment="Center"/><TextBlock Text="Chiến lược" FontSize="16"/></StackPanel>
        </Button>
        <Button x:Name="NavMonitoring" Grid.Column="3" Classes="navTab" Tag="monitoring" Click="NavButton_OnClick">
          <StackPanel Spacing="7"><Path Width="23" Height="23" Stretch="Uniform" Stroke="#E2EEFF" StrokeThickness="1.35" Data="M2 13 V10 A10 10 0 0 1 22 10 V13 M2 11 H5 V17 H2 Z M19 11 H22 V17 H19 Z M12 9 A3 3 0 1 0 12 15 A3 3 0 1 0 12 9 M7 22 L9 17 H15 L17 22 Z" HorizontalAlignment="Center"/><TextBlock Text="Giám sát" FontSize="16"/></StackPanel>
        </Button>
        <Button x:Name="NavOrders" Grid.Column="4" Classes="navTab" Tag="orders" Click="NavButton_OnClick">
          <StackPanel Spacing="7"><Path Width="23" Height="23" Stretch="Uniform" Stroke="#E2EEFF" StrokeThickness="1.35" Data="M5 4 H19 L21 6 V22 H3 V6 Z M8 4 V1 M16 4 V1 M3 9 H21 M8 13 L10 15 L15 11 M8 19 H16" HorizontalAlignment="Center"/><TextBlock Text="Lệnh &amp; Vị thế" FontSize="15"/></StackPanel>
        </Button>
        <Button x:Name="NavBacktest" Grid.Column="5" Classes="navTab" Tag="backtest" Click="NavButton_OnClick">
          <StackPanel Spacing="7"><Path Width="23" Height="23" Stretch="Uniform" Stroke="#E2EEFF" StrokeThickness="1.35" Data="M1 5 H23 M1 12 H23 M1 19 H23 M7 2 V8 M17 9 V15 M10 16 V22" HorizontalAlignment="Center"/><TextBlock Text="Backtest" FontSize="16"/></StackPanel>
        </Button>
        <Button x:Name="NavOptimization" Grid.Column="6" Classes="navTab" Tag="optimization" Click="NavButton_OnClick">
          <StackPanel Spacing="7"><Path Width="23" Height="23" Stretch="Uniform" Stroke="#E2EEFF" StrokeThickness="1.35" Data="M12 1 V23 M1 12 H23 M4 4 L20 20 M4 20 L20 4 M8 12 A4 4 0 1 0 16 12 A4 4 0 1 0 8 12" HorizontalAlignment="Center"/><TextBlock Text="Tối ưu" FontSize="16"/></StackPanel>
        </Button>
        <Button x:Name="NavLogs" Grid.Column="7" Classes="navTab" Tag="logs" Click="NavButton_OnClick">
          <StackPanel Spacing="7"><Path Width="23" Height="23" Stretch="Uniform" Stroke="#E2EEFF" StrokeThickness="1.35" Data="M5 1 H15 L21 7 V23 H5 Z M15 1 V7 H21 M9 11 H17 M9 15 H17 M9 19 H15" HorizontalAlignment="Center"/><TextBlock Text="Nhật ký" FontSize="16"/></StackPanel>
        </Button>
        <Button x:Name="NavTools" Grid.Column="8" Classes="navTab" Tag="tools" Click="NavButton_OnClick">
          <StackPanel Spacing="7"><Path Width="23" Height="23" Stretch="Uniform" Stroke="#E2EEFF" StrokeThickness="1.35" Data="M4 2 L8 6 L6 8 L2 4 L2 9 L6 12 L9 11 L19 22 L22 19 L11 9 L12 6 L9 2 Z M19 2 L22 5 L17 10 M10 17 L5 22 L2 19 L7 14" HorizontalAlignment="Center"/><TextBlock Text="Công cụ" FontSize="16"/></StackPanel>
        </Button>
        <Button x:Name="NavSettings" Grid.Column="9" Classes="navTab" Tag="settings" Click="NavButton_OnClick">
          <StackPanel Spacing="7"><Path Width="23" Height="23" Stretch="Uniform" Stroke="#E2EEFF" StrokeThickness="1.35" Data="M9 2 H15 L16 6 L20 7 L22 12 L20 17 L16 18 L15 22 H9 L8 18 L4 17 L2 12 L4 7 L8 6 Z M12 8 A4 4 0 1 0 12 16 A4 4 0 1 0 12 8" HorizontalAlignment="Center"/><TextBlock Text="Cài đặt" FontSize="16"/></StackPanel>
        </Button>
        <StackPanel Grid.Column="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock x:Name="HeaderClockText" Text="--:--:--" FontSize="17" HorizontalAlignment="Right"/>
          <TextBlock x:Name="HeaderDateText" Text="--/--/----" Foreground="#91AAC2" FontSize="14" HorizontalAlignment="Right"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid x:Name="DashboardGrid" Grid.Row="2" ColumnDefinitions="288,*" RowDefinitions="*,Auto" ColumnSpacing="14" Margin="14,0,14,0">
      <!-- Reused left status column shown in approved Overview / Strategy / Monitoring mockups -->
      <ScrollViewer x:Name="LiveSidebar" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="8">
          <Border x:Name="SidebarQuoteCard" Classes="panel" Padding="17,10" MinHeight="166">
            <StackPanel x:Name="SidebarQuoteContent" Spacing="3">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <TextBlock x:Name="SymbolValue" Text="XAUUSD" FontSize="26" FontWeight="Bold" Foreground="#B9D5F0"/>
                <TextBlock x:Name="SymbolConnectionDot" Text="●" Foreground="#8092A6" FontSize="18" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock x:Name="BidValue" Text="—" FontSize="40" FontWeight="Bold" Foreground="#17E58B"/>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="SpreadValue" Text="Spread: —" FontSize="18" Foreground="#FF415C"/>
                <TextBlock x:Name="QuoteFreshnessText" Grid.Column="1" Text="Chờ giá" FontSize="11" Foreground="#FFD34D" VerticalAlignment="Center"/>
              </Grid>
              <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,5,0,0">
                <TextBlock Text="Bid" Foreground="#17E58B"/>
                <TextBlock x:Name="SidebarBidText" Grid.Column="1" Text="—" Margin="10,0,0,0"/>
                <TextBlock Grid.Column="2" Text="Ask" Foreground="#17E58B" Margin="0,0,8,0"/>
                <TextBlock x:Name="AskValue" Grid.Column="3" Text="—"/>
              </Grid>
            </StackPanel>
          </Border>

          <Border x:Name="SidebarEaCard" Classes="panel" MinHeight="116">
            <StackPanel>
              <Border Background="#082038" Padding="12,7">
                <TextBlock Text="Trạng thái EA" Classes="panelTitle"/>
              </Border>
              <Border Margin="0,0,0,0" Background="#063928" Padding="12,10">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Button Grid.Column="0" Width="36" Height="36" Padding="0" CornerRadius="18" Background="Transparent" BorderBrush="#00E58A" BorderThickness="2" Foreground="#00E58A" FontSize="21" Content="▶" Click="StartEngine_OnClick" ToolTip.Tip="Khởi động Python Engine"/>
                  <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="EaRunStateText" Text="CHỜ KẾT NỐI" Foreground="#FFD34D" FontWeight="Bold" FontSize="16"/>
                    <TextBlock x:Name="HeaderEnginePillText" Text="ENGINE STARTING" Foreground="#A8C2DA" FontSize="13"/>
                  </StackPanel>
                  <Button Grid.Column="2" Width="40" Height="25" Padding="0" CornerRadius="13" Background="#00CB78" BorderBrush="#13F49A" BorderThickness="1" Foreground="White" FontSize="16" Content="■" Click="StopEngine_OnClick" ToolTip.Tip="Dừng Python Engine"/>
                </Grid>
              </Border>
            </StackPanel>
          </Border>

          <Border x:Name="SidebarAccountCard" Classes="panel" MinHeight="250">
            <StackPanel>
              <Border Background="#082038" Padding="12,7"><TextBlock Text="Tài khoản giao dịch" Classes="panelTitle"/></Border>
              <Grid x:Name="SidebarAccountRows" Margin="15,9" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="11">
                <TextBlock Grid.Row="0" Text="Balance" Classes="label"/><TextBlock x:Name="BalanceValue" Grid.Row="0" Grid.Column="1" Text="—" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="1" Text="Equity" Classes="label"/><TextBlock x:Name="EquityValue" Grid.Row="1" Grid.Column="1" Text="—" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="2" Text="Lợi nhuận hôm nay" Classes="label"/><TextBlock x:Name="DailyProfitValue" Grid.Row="2" Grid.Column="1" Text="—" Foreground="#18E58B"/>
                <TextBlock Grid.Row="3" Text="Lệnh hôm nay" Classes="label"/><TextBlock x:Name="DailyTradeCountValue" Grid.Row="3" Grid.Column="1" Text="—"/>
                <TextBlock Grid.Row="4" Text="Lệnh đang mở" Classes="label"/><TextBlock x:Name="SidebarPositionsText" Grid.Row="4" Grid.Column="1" Text="—"/>
                <TextBlock Grid.Row="5" Text="Max DD hôm nay" Classes="label"/><TextBlock x:Name="DailyDrawdownValue" Grid.Row="5" Grid.Column="1" Text="—" Foreground="#FF415C"/>
              </Grid>
              <StackPanel IsVisible="False"><TextBlock x:Name="MarginFreeValue"/><TextBlock x:Name="AccountModeValue"/><TextBlock x:Name="CurrencyValue"/></StackPanel>
            </StackPanel>
          </Border>

          <Border x:Name="SidebarConnectionCard" Classes="panel" MinHeight="232">
            <StackPanel>
              <Border Background="#082038" Padding="12,7"><TextBlock Text="Kết nối &amp; Hệ thống" Classes="panelTitle"/></Border>
              <Grid x:Name="SidebarConnectionRows" Margin="12,8" ColumnDefinitions="19,*,74" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                <TextBlock x:Name="TerminalConnectionDot" Grid.Row="0" Text="●" Foreground="#8092A6" Margin="0,0,8,0"/><TextBlock Grid.Row="0" Grid.Column="1" Text="MT5 Terminal" Classes="label" FontSize="14"/><TextBlock x:Name="BridgeStateText" Grid.Row="0" Grid.Column="2" Text="WAITING" Foreground="#FFD34D" FontSize="12" HorizontalAlignment="Right"/>
                <TextBlock x:Name="BridgeConnectionDot" Grid.Row="1" Text="●" Foreground="#8092A6" Margin="0,0,8,0"/><TextBlock Grid.Row="1" Grid.Column="1" Text="EA Bridge" Classes="label" FontSize="14"/><TextBlock x:Name="BridgeAgeText" Grid.Row="1" Grid.Column="2" Text="—" Foreground="#9AB5CF" FontSize="12" HorizontalAlignment="Right"/>
                <TextBlock x:Name="EngineConnectionDot" Grid.Row="2" Text="●" Foreground="#8092A6" Margin="0,0,8,0"/><TextBlock Grid.Row="2" Grid.Column="1" Text="Python Engine" Classes="label" FontSize="14"/><TextBlock x:Name="EngineStateText" Grid.Row="2" Grid.Column="2" Text="STARTING" Foreground="#FFD34D" FontSize="12" HorizontalAlignment="Right"/>
                <TextBlock x:Name="MarketConnectionDot" Grid.Row="3" Text="●" Foreground="#8092A6" Margin="0,0,8,0"/><TextBlock Grid.Row="3" Grid.Column="1" Text="Dữ liệu thị trường" Classes="label" FontSize="14"/><TextBlock x:Name="LastHeartbeatText" Grid.Row="3" Grid.Column="2" Text="—" Foreground="#9AB5CF" FontSize="12" HorizontalAlignment="Right"/>
              </Grid>
              <Grid ColumnDefinitions="Auto,*" Margin="12,0,12,6"><TextBlock Text="An toàn" FontSize="13" Classes="label"/><TextBlock x:Name="GuardianReasonValue" Grid.Column="1" Text="LOCKED" FontSize="11" Foreground="#FFD34D" HorizontalAlignment="Right"/></Grid>
              <TextBlock x:Name="EngineDetailText" Text="Đang chuẩn bị Engine..." Classes="dim" FontSize="10" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="12,0,12,4"/>
              <TextBlock x:Name="BridgeDetailText" Text="Chưa nhận snapshot MT5." Classes="dim" FontSize="10" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="12,0,12,4"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <StackPanel IsVisible="False">
        <TextBlock x:Name="PageTitle" Text="Tổng quan"/>
        <TextBlock x:Name="PageSubtitle" Text=""/>
      </StackPanel>

      <!-- Overview -->
      <ScrollViewer Grid.Column="1" x:Name="OverviewScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="OverviewContent" Spacing="8">
          <Grid ColumnDefinitions="3.18*,1*" ColumnSpacing="8">
            <Border Grid.Column="0" Classes="panel" Height="344">
              <Grid RowDefinitions="42,*,27">
                <Grid Grid.Row="0" Background="#082038" ColumnDefinitions="Auto,*,Auto" Margin="12,0">
                  <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="XAUUSD" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="M5" FontSize="17" FontWeight="Bold"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="30,0,0,0" Spacing="5" VerticalAlignment="Center">
                    <Border Classes="panelSoft" Padding="9,4"><TextBlock Text="M1"/></Border>
                    <Border Classes="panelSoft" Padding="9,4"><TextBlock Text="M3"/></Border>
                    <Border Background="#0866F4" BorderBrush="#2A8EFF" BorderThickness="1" CornerRadius="4" Padding="9,4"><TextBlock Text="M5"/></Border>
                    <Border Classes="panelSoft" Padding="9,4"><TextBlock Text="M15"/></Border>
                    <Border Classes="panelSoft" Padding="9,4"><TextBlock Text="M30"/></Border>
                    <Border Classes="panelSoft" Padding="9,4"><TextBlock Text="H1"/></Border>
                    <Border Classes="panelSoft" Padding="9,4"><TextBlock Text="H4"/></Border>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <TextBlock Text="+ So sánh" Classes="label"/>
                    <TextBlock Text="ƒ  Chỉ báo" Classes="label"/>
                    <TextBlock Text="Nến Nhật" Classes="label"/>
                  </StackPanel>
                </Grid>

                <local:MarketChartControl x:Name="OverviewMarketChart" Grid.Row="1" Grid.RowSpan="2"/>
                <StackPanel IsVisible="False"><TextBlock x:Name="ChartLastValue"/><TextBlock x:Name="ChartRangeValue"/><TextBlock x:Name="ChartMinValue"/><TextBlock x:Name="ChartMaxValue"/></StackPanel>
              </Grid>
            </Border>

            <Border Grid.Column="1" Classes="panel" Height="344">
              <StackPanel>
                <Border Background="#082038" Padding="12,8"><TextBlock Text="Thông tin chiến lược (Realtime)" Classes="panelTitle"/></Border>
                <Grid Margin="12,8" ColumnDefinitions="1.2*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="9">
                  <TextBlock Grid.Row="0" Text="Direction" Classes="label"/><TextBlock x:Name="OverviewDirectionState" Grid.Row="0" Grid.Column="1" Text="—" Foreground="#FF415C" FontWeight="Bold"/>
                  <TextBlock Grid.Row="1" Text="Pullback" Classes="label"/><TextBlock x:Name="OverviewPullbackState" Grid.Row="1" Grid.Column="1" Text="—" Foreground="#FFD34D"/>
                  <TextBlock Grid.Row="2" Text="Trigger" Classes="label"/><TextBlock x:Name="OverviewTriggerState" Grid.Row="2" Grid.Column="1" Text="—"/>
                  <TextBlock Grid.Row="3" Text="Z-Score (Trigger)" Classes="label"/><TextBlock x:Name="OverviewZTrigger" Grid.Row="3" Grid.Column="1" Text="—"/>
                  <TextBlock Grid.Row="4" Text="RSI (Trigger)" Classes="label"/><TextBlock x:Name="OverviewRsiTrigger" Grid.Row="4" Grid.Column="1" Text="—"/>
                  <TextBlock Grid.Row="5" Text="Z-Score (Pullback)" Classes="label"/><TextBlock x:Name="OverviewZPullback" Grid.Row="5" Grid.Column="1" Text="—"/>
                  <TextBlock Grid.Row="6" Text="RSI (Pullback)" Classes="label"/><TextBlock x:Name="OverviewRsiPullback" Grid.Row="6" Grid.Column="1" Text="—"/>
                  <TextBlock Grid.Row="7" Text="Direction MA" Classes="label"/><TextBlock x:Name="OverviewMaValue" Grid.Row="7" Grid.Column="1" Text="—"/>
                  <TextBlock Grid.Row="8" Text="Trạng thái" Classes="label"/><TextBlock x:Name="StrategyStateValue" Grid.Row="8" Grid.Column="1" Text="STALE" Foreground="#FFD34D" TextWrapping="Wrap" FontSize="13"/>
                </Grid>
              </StackPanel>
            </Border>
          </Grid>

          <Border Classes="panel" MinHeight="250">
            <StackPanel>
              <Grid Background="#082038" ColumnDefinitions="*,Auto" Margin="12,7">
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <TextBlock Text="▣" Foreground="#62AFFF"/>
                  <TextBlock Text="Công cụ &amp; Tham số đầy đủ (Trung tâm cấu hình)" FontSize="16" Classes="panelTitle"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                  <Button Classes="secondary" Content="⚡  Cài đặt nhanh" Tag="timeframes" Click="ConfigurationShortcut_OnClick"/>
                  <Button Classes="secondary" Content="▣  Preset" Tag="load" Click="ConfigurationShortcut_OnClick"/>
                  <Button Classes="secondary" Content="▣  Quản lý set" Tag="profile" Click="ConfigurationShortcut_OnClick"/>
                  <Button Classes="secondary" Content="▥  Hướng dẫn" Click="QuickHelp_OnClick"/>
                </StackPanel>
              </Grid>
              <WrapPanel Margin="6,5,6,5">
                <Button Classes="primary" Margin="2" Padding="8,6" Content="01. Timeframe &amp; Logic" Tag="timeframes" Click="ConfigurationShortcut_OnClick"/>
                <Button Classes="secondary" Margin="2" Padding="8,6" Content="02. Direction" Tag="direction" Click="ConfigurationShortcut_OnClick"/>
                <Button Classes="secondary" Margin="2" Padding="8,6" Content="03. Pullback" Tag="pullback" Click="ConfigurationShortcut_OnClick"/>
                <Button Classes="secondary" Margin="2" Padding="8,6" Content="04. Trigger" Tag="trigger" Click="ConfigurationShortcut_OnClick"/>
                <Button Classes="secondary" Margin="2" Padding="8,6" Content="05. Z-Score" Tag="pullback" Click="ConfigurationShortcut_OnClick"/>
                <Button Classes="secondary" Margin="2" Padding="8,6" Content="06. RSI" Tag="trigger" Click="ConfigurationShortcut_OnClick"/>
                <Button Classes="secondary" Margin="2" Padding="8,6" Content="07. Entry" Tag="entry" Click="ConfigurationShortcut_OnClick"/>
                <Button Classes="secondary" Margin="2" Padding="8,6" Content="08. SL/TP" Tag="stop_loss" Click="ConfigurationShortcut_OnClick"/>
                <Button Classes="secondary" Margin="2" Padding="8,6" Content="09. Risk" Tag="risk" Click="ConfigurationShortcut_OnClick"/>
                <Button Classes="secondary" Margin="2" Padding="8,6" Content="10. Bộ lọc" Tag="filters.adx" Click="ConfigurationShortcut_OnClick"/>
                <Button Classes="secondary" Margin="2" Padding="8,6" Content="11. Thời gian" Tag="sessions" Click="ConfigurationShortcut_OnClick"/>
                <Button Classes="secondary" Margin="2" Padding="8,6" Content="12. Khác" Tag="profile" Click="ConfigurationShortcut_OnClick"/>
              </WrapPanel>
              <Grid ColumnDefinitions="1.05*,1.05*,1.2*" Margin="12,2,12,6" ColumnSpacing="18">
                <StackPanel Grid.Column="0" Spacing="5">
                  <TextBlock Text="Khung thời gian chính" FontWeight="SemiBold"/>
                  <Grid ColumnDefinitions="*,195"><TextBlock Text="Direction TF" Classes="label" VerticalAlignment="Center"/><ComboBox x:Name="QuickDirection" Grid.Column="1" HorizontalAlignment="Stretch" MinHeight="30"/></Grid>
                  <Grid ColumnDefinitions="*,195"><TextBlock Text="Pullback TF" Classes="label" VerticalAlignment="Center"/><ComboBox x:Name="QuickPullback" Grid.Column="1" HorizontalAlignment="Stretch" MinHeight="30"/></Grid>
                  <Grid ColumnDefinitions="*,195"><TextBlock Text="Trigger TF" Classes="label" VerticalAlignment="Center"/><ComboBox x:Name="QuickTrigger" Grid.Column="1" HorizontalAlignment="Stretch" MinHeight="30"/></Grid>
                  <StackPanel IsVisible="False"><TextBlock x:Name="DirectionTfValue"/><TextBlock x:Name="PullbackTfValue"/><TextBlock x:Name="TriggerTfValue"/></StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock Text="Logic kết hợp" FontWeight="SemiBold"/>
                  <Grid ColumnDefinitions="*,195"><TextBlock Text="Điều kiện Pullback" Classes="label" VerticalAlignment="Center"/><ComboBox x:Name="QuickLogic" Grid.Column="1" MinHeight="30" IsEnabled="False" ToolTip.Tip="Logic kết hợp bộ lọc Pullback; logic Trigger được chỉnh ở tab Cấu hình."/></Grid>
                  <CheckBox x:Name="QuickAllowBuy" Content="Cho phép BUY" MinHeight="24"/>
                  <CheckBox x:Name="QuickAllowSell" Content="Cho phép SELL" MinHeight="24"/>
                  <Button x:Name="QuickApply" Classes="primary" Padding="10,4" Height="28" Content="Áp dụng cấu hình nhanh" Click="QuickApply_OnClick"/>
                  <StackPanel IsVisible="False"><TextBlock x:Name="DirectionRuleValue"/><TextBlock x:Name="TpSlValue"/><TextBlock x:Name="TradePermissionsText"/></StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="5">
                  <TextBlock Text="Preset cấu hình" FontWeight="SemiBold"/>
                  <Border Classes="panelSoft" Padding="10,7"><TextBlock x:Name="ProfileValue" Text="Profile: Baseline"/></Border>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Classes="secondary" Content="Lưu preset" HorizontalAlignment="Stretch" Tag="save" Click="ConfigurationShortcut_OnClick"/>
                    <Button Grid.Column="1" Classes="secondary" Content="Mở preset" HorizontalAlignment="Stretch" Tag="load" Click="ConfigurationShortcut_OnClick"/>
                  </Grid>
                  <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                    <Button Classes="secondary" Content="Mở .set" HorizontalAlignment="Stretch" Padding="7,5" Tag="import-set" Click="ConfigurationShortcut_OnClick"/>
                    <Button Grid.Column="1" Classes="secondary" Content="Lưu .set" HorizontalAlignment="Stretch" Padding="7,5" Tag="export-set" Click="ConfigurationShortcut_OnClick"/>
                    <Button Grid.Column="2" Classes="secondary" Content="Xuất JSON" HorizontalAlignment="Stretch" Padding="7,5" Tag="save" Click="ConfigurationShortcut_OnClick"/>
                    <Button Grid.Column="3" Classes="secondary" Content="Nhập JSON" HorizontalAlignment="Stretch" Padding="7,5" Tag="load" Click="ConfigurationShortcut_OnClick"/>
                  </Grid>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <Grid ColumnDefinitions="1.55*,1*" ColumnSpacing="8">
            <Border Grid.Column="0" Classes="panel" MinHeight="177">
              <StackPanel>
                <Border Background="#082038" Padding="12,7">
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Lệnh gần đây" Classes="panelTitle"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="Positions:" Classes="dim"/><TextBlock x:Name="PositionsCountValue" Text="0"/>
                      <TextBlock Text="Orders:" Classes="dim"/><TextBlock x:Name="OrdersCountValue" Text="0"/>
                    </StackPanel>
                  </Grid>
                </Border>
                <Grid Margin="12,7" ColumnDefinitions="0.5*,1.3*,0.8*,0.7*,1*,1*,0.8*,0.8*,0.8*">
                  <TextBlock Text="#" Classes="dim"/><TextBlock Grid.Column="1" Text="Thời gian" Classes="dim"/><TextBlock Grid.Column="2" Text="Loại" Classes="dim"/><TextBlock Grid.Column="3" Text="Lot" Classes="dim"/><TextBlock Grid.Column="4" Text="Giá vào" Classes="dim"/><TextBlock Grid.Column="5" Text="Giá đóng" Classes="dim"/><TextBlock Grid.Column="6" Text="Lãi/Lỗ" Classes="dim"/><TextBlock Grid.Column="7" Text="TP" Classes="dim"/><TextBlock Grid.Column="8" Text="SL" Classes="dim"/>
                </Grid>
                <TextBlock x:Name="RecentOrdersEmptyText" Text="Chưa có dữ liệu lệnh chi tiết." Classes="dim" HorizontalAlignment="Center" Margin="0,20,0,0"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="panel" MinHeight="177">
              <StackPanel>
                <Border Background="#082038" Padding="12,7"><TextBlock Text="Nhật ký hệ thống" Classes="panelTitle"/></Border>
                <Grid Margin="12,6" ColumnDefinitions="90,80,*"><TextBlock Text="Thời gian" Classes="dim"/><TextBlock Grid.Column="1" Text="Mức" Classes="dim"/><TextBlock Grid.Column="2" Text="Thông tin" Classes="dim"/></Grid>
                <TextBlock x:Name="QuickLogText" Text="Đang khởi tạo Control Center..." FontFamily="Consolas" FontSize="12" Foreground="#9FC2DE" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="12,2,12,8"/>
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </ScrollViewer>

      <local:ConfigurationEditor x:Name="ConfigurationEditor"
                                 Grid.ColumnSpan="2"
                                 IsVisible="False"/>

      <local:StrategyDashboard x:Name="StrategyDashboard"
                               Grid.Column="1"
                               IsVisible="False"/>

      <local:MonitoringDashboard x:Name="MonitoringDashboard"
                                 Grid.Column="1"
                                 IsVisible="False"/>
      <ContentControl x:Name="MonitoringAlertsHost" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" IsVisible="False"/>

      <local:OrdersPositionsDashboard x:Name="OrdersPositionsDashboard"
                                      Grid.ColumnSpan="2"
                                      IsVisible="False"/>

      <local:JournalDashboard x:Name="JournalDashboard"
                              Grid.ColumnSpan="2"
                              IsVisible="False"/>

      <local:BacktestDashboard x:Name="BacktestDashboard"
                               Grid.Column="1"
                               IsVisible="False"/>

      <local:OptimizerDashboard x:Name="OptimizerDashboard"
                                Grid.Column="1"
                                IsVisible="False"/>

      <local:ToolsDashboard x:Name="ToolsView" Grid.ColumnSpan="2" IsVisible="False"/>
      <local:SettingsDashboard x:Name="SettingsView" Grid.Column="1" IsVisible="False"/>

      <Border x:Name="PlaceholderContent" Grid.ColumnSpan="2" Classes="panel" IsVisible="False">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="650">
          <TextBlock x:Name="PlaceholderTitle" Text="Tab chưa triển khai" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock x:Name="PlaceholderDetail" Text="Chức năng backend chưa được triển khai." Classes="dim" TextWrapping="Wrap" TextAlignment="Center"/>
          <TextBlock Text="Bố cục sẽ bám đúng ảnh UI reference; không hiển thị dữ liệu giao dịch giả." Foreground="#FFD34D" TextAlignment="Center"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Approved narrow status footer -->
    <Border Grid.Row="3" Background="#03162A" BorderBrush="#124467" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto" Margin="20,0">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Text="●" Foreground="#18E58B" FontSize="12"/>
          <TextBlock Text="Python Engine:" Classes="dim" FontSize="12"/>
          <TextBlock x:Name="FooterEngineStateText" Text="Starting" FontSize="12"/>
          <TextBlock Text="|" Classes="dim" FontSize="12"/>
          <TextBlock Text="Model: Rule-based (Z + RSI)" Classes="dim" FontSize="12"/>
          <TextBlock Text="|" Classes="dim" FontSize="12"/>
          <TextBlock Text="Log: ON" Classes="dim" FontSize="12"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Text="Giờ máy:" Classes="dim" FontSize="12"/>
          <TextBlock x:Name="FooterServerTimeText" Text="—" FontSize="12"/>
          <TextBlock Text="|" Classes="dim" FontSize="12"/>
          <TextBlock Text="Spread:" Classes="dim" FontSize="12"/>
          <TextBlock x:Name="FooterSpreadText" Text="—" FontSize="12"/>
          <TextBlock Text="|" Classes="dim" FontSize="12"/>
          <TextBlock Text="Account:" Classes="dim" FontSize="12"/>
          <TextBlock x:Name="FooterAccountText" Text="—" FontSize="12"/>
          <TextBlock Text="Leverage:" Classes="dim" FontSize="12"/>
          <TextBlock x:Name="FooterLeverageText" Text="—" FontSize="12"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
