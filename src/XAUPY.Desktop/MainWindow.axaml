<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="XAUPY.Desktop.MainWindow"
        Width="1500"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        Background="#07111F"
        Title="XAUPY Control Center — Task 001 Foundation">
  <Window.Styles>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="#10233A"/>
      <Setter Property="Foreground" Value="#DCE9F8"/>
      <Setter Property="BorderBrush" Value="#1E3E62"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="Margin" Value="4"/>
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="Background" Value="#17395F"/>
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#0D1A2B"/>
      <Setter Property="BorderBrush" Value="#1C3959"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="18"/>
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#8FA8C2"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="64,*,34">
    <Border Grid.Row="0" Background="#0A1829" BorderBrush="#183554" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="18,0">
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
          <Border Width="34" Height="34" CornerRadius="8" Background="#1479FF">
            <TextBlock Text="N30" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
          </Border>
          <TextBlock Text="XAUPY Control Center" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock Text="Task 001 Foundation" Classes="muted" VerticalAlignment="Center"/>
        </StackPanel>
        <Border Grid.Column="2" Background="#27321C" BorderBrush="#4E6B28" BorderThickness="1" CornerRadius="12" Padding="10,5" VerticalAlignment="Center">
          <TextBlock Text="NO TRADING — FOUNDATION ONLY" Foreground="#C9E77B" FontWeight="Bold"/>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="220,*">
      <Border Grid.Column="0" Background="#091525" BorderBrush="#183554" BorderThickness="0,0,1,0">
        <ScrollViewer>
          <StackPanel Margin="12">
            <TextBlock Text="ĐIỀU HƯỚNG" Classes="muted" Margin="8,8,8,10"/>
            <Button Classes="nav" Content="Tổng quan" Tag="overview" Click="NavButton_OnClick"/>
            <Button Classes="nav" Content="Cấu hình" Tag="configuration" Click="NavButton_OnClick"/>
            <Button Classes="nav" Content="Chiến lược" Tag="strategy" Click="NavButton_OnClick"/>
            <Button Classes="nav" Content="Giám sát" Tag="monitoring" Click="NavButton_OnClick"/>
            <Button Classes="nav" Content="Lệnh &amp; Vị thế" Tag="orders" Click="NavButton_OnClick"/>
            <Button Classes="nav" Content="Backtest" Tag="backtest" Click="NavButton_OnClick"/>
            <Button Classes="nav" Content="Tối ưu" Tag="optimization" Click="NavButton_OnClick"/>
            <Button Classes="nav" Content="Nhật ký" Tag="logs" Click="NavButton_OnClick"/>
            <Button Classes="nav" Content="Công cụ" Tag="tools" Click="NavButton_OnClick"/>
            <Button Classes="nav" Content="Cài đặt" Tag="settings" Click="NavButton_OnClick"/>
            <Border Classes="card" Margin="4,22,4,4">
              <StackPanel Spacing="7">
                <TextBlock Text="Kiến trúc đã khóa" FontWeight="SemiBold"/>
                <TextBlock Text="Avalonia Desktop" Foreground="#59D9FF"/>
                <TextBlock Text="Python Engine" Foreground="#B08CFF"/>
                <TextBlock Text="MQL5 Bridge" Foreground="#69D48C"/>
                <TextBlock Text="IPC chưa triển khai ở Task 001." Classes="muted" TextWrapping="Wrap" Margin="0,5,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <ScrollViewer Grid.Column="1">
        <StackPanel Margin="28" Spacing="18">
          <TextBlock x:Name="PageTitle" Text="Tổng quan" FontSize="30" FontWeight="Bold"/>
          <TextBlock x:Name="PageSubtitle" Text="Foundation shell: xác nhận stack Avalonia/.NET có thể build và phát hành qua GitHub CI." Classes="muted" FontSize="15" TextWrapping="Wrap"/>
          <Border Classes="card">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
              <StackPanel Grid.Column="0" Spacing="7">
                <TextBlock Text="Desktop UI" Classes="muted"/>
                <TextBlock Text="Avalonia 12 / .NET 10" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="Shell đang hoạt động" Foreground="#69D48C"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="7">
                <TextBlock Text="Python Engine" Classes="muted"/>
                <TextBlock Text="Stub contract only" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="Không có chiến lược giao dịch" Foreground="#E9C46A"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="7">
                <TextBlock Text="MT5 Bridge" Classes="muted"/>
                <TextBlock Text="Not implemented" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="Không thể gửi lệnh" Foreground="#E9C46A"/>
              </StackPanel>
            </Grid>
          </Border>
          <Grid ColumnDefinitions="2*,*" ColumnSpacing="18">
            <Border Grid.Column="0" Classes="card" MinHeight="330">
              <StackPanel Spacing="12">
                <TextBlock Text="UI Source-of-Truth" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="docs/ui-reference/" Foreground="#59D9FF"/>
                <TextBlock Text="Task 001 chỉ dựng khung ứng dụng và điều hướng. Các tab chức năng sẽ được triển khai từng task sau khi CI và build foundation được xác nhận." Classes="muted" TextWrapping="Wrap"/>
                <Border Background="#091421" CornerRadius="8" Padding="18" Margin="0,8,0,0">
                  <StackPanel Spacing="8">
                    <TextBlock Text="10 tab đã khai báo" FontWeight="SemiBold"/>
                    <TextBlock Text="Tổng quan · Cấu hình · Chiến lược · Giám sát · Lệnh &amp; Vị thế" Classes="muted"/>
                    <TextBlock Text="Backtest · Tối ưu · Nhật ký · Công cụ · Cài đặt" Classes="muted"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Text="Acceptance Task 001" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="✓ Desktop shell" Foreground="#69D48C"/>
                <TextBlock Text="✓ Python heartbeat contract" Foreground="#69D48C"/>
                <TextBlock Text="• CI validation" Foreground="#E9C46A"/>
                <TextBlock Text="• Windows build artifact" Foreground="#E9C46A"/>
                <TextBlock Text="Trading remains disabled." Classes="muted" Margin="0,12,0,0"/>
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="2" Background="#081321" BorderBrush="#183554" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto" Margin="18,0">
        <TextBlock Text="XAUPY • one task at a time • CI evidence required" Classes="muted" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="TASK XAUPY-001" Foreground="#59D9FF" VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </Grid>
</Window>
