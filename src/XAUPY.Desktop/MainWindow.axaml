<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="XAUPY.Desktop.MainWindow"
        Width="1500"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        Background="#07111F"
        Title="XAUPY Control Center — Task 003 MT5 Bridge">
  <Window.Styles>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="#10233A"/>
      <Setter Property="Foreground" Value="#DCE9F8"/>
      <Setter Property="BorderBrush" Value="#1E3E62"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="Margin" Value="4"/>
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="Background" Value="#17395F"/>
    </Style>
    <Style Selector="Button.action">
      <Setter Property="Background" Value="#123B66"/>
      <Setter Property="Foreground" Value="#E8F4FF"/>
      <Setter Property="BorderBrush" Value="#245F96"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#0D1A2B"/>
      <Setter Property="BorderBrush" Value="#1C3959"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="18"/>
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#8FA8C2"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="64,*,34">
    <Border Grid.Row="0" Background="#0A1829" BorderBrush="#183554" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="18,0">
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
          <Border Width="34" Height="34" CornerRadius="8" Background="#1479FF">
            <TextBlock Text="N30" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
          </Border>
          <TextBlock Text="XAUPY Control Center" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock Text="Task 003 MT5 Bridge" Classes="muted" VerticalAlignment="Center"/>
        </StackPanel>
        <Border Grid.Column="2" Background="#27321C" BorderBrush="#4E6B28" BorderThickness="1" CornerRadius="12" Padding="10,5" VerticalAlignment="Center">
          <TextBlock Text="EXECUTION LOCKED — DATA ONLY" Foreground="#C9E77B" FontWeight="Bold"/>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="220,*">
      <Border Grid.Column="0" Background="#091525" BorderBrush="#183554" BorderThickness="0,0,1,0">
        <ScrollViewer>
          <StackPanel Margin="12">
            <TextBlock Text="ĐIỀU HƯỚNG" Classes="muted" Margin="8,8,8,10"/>
            <Button Classes="nav" Content="Tổng quan" Tag="overview" Click="NavButton_OnClick"/>
            <Button Classes="nav" Content="Cấu hình" Tag="configuration" Click="NavButton_OnClick"/>
            <Button Classes="nav" Content="Chiến lược" Tag="strategy" Click="NavButton_OnClick"/>
            <Button Classes="nav" Content="Giám sát" Tag="monitoring" Click="NavButton_OnClick"/>
            <Button Classes="nav" Content="Lệnh &amp; Vị thế" Tag="orders" Click="NavButton_OnClick"/>
            <Button Classes="nav" Content="Backtest" Tag="backtest" Click="NavButton_OnClick"/>
            <Button Classes="nav" Content="Tối ưu" Tag="optimization" Click="NavButton_OnClick"/>
            <Button Classes="nav" Content="Nhật ký" Tag="logs" Click="NavButton_OnClick"/>
            <Button Classes="nav" Content="Công cụ" Tag="tools" Click="NavButton_OnClick"/>
            <Button Classes="nav" Content="Cài đặt" Tag="settings" Click="NavButton_OnClick"/>

            <Border Classes="card" Margin="4,22,4,4">
              <StackPanel Spacing="7">
                <TextBlock Text="Kiến trúc" FontWeight="SemiBold"/>
                <TextBlock Text="Avalonia Desktop" Foreground="#59D9FF"/>
                <TextBlock Text="↕ IPC v1 / Loopback" Foreground="#E9C46A"/>
                <TextBlock Text="Python Engine" Foreground="#B08CFF"/>
                <TextBlock Text="↕ MT5 Bridge snapshots" Foreground="#E9C46A"/>
                <TextBlock Text="MQL5 EA • execution locked" Foreground="#69D48C"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <ScrollViewer Grid.Column="1">
        <StackPanel Margin="28" Spacing="18">
          <TextBlock x:Name="PageTitle" Text="Tổng quan" FontSize="30" FontWeight="Bold"/>
          <TextBlock x:Name="PageSubtitle"
                     Text="Task 003: nhận dữ liệu MT5 thật qua Bridge EA; lớp thực thi vẫn khóa cứng."
                     Classes="muted"
                     FontSize="15"
                     TextWrapping="Wrap"/>

          <Border Classes="card">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
              <StackPanel Grid.Column="0" Spacing="7">
                <TextBlock Text="Desktop UI" Classes="muted"/>
                <TextBlock Text="Avalonia 12 / .NET 10" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="Control Center đang hoạt động" Foreground="#69D48C"/>
              </StackPanel>

              <StackPanel Grid.Column="1" Spacing="7">
                <TextBlock Text="Python Engine" Classes="muted"/>
                <TextBlock x:Name="EngineStateText" Text="STARTING" FontSize="19" FontWeight="SemiBold" Foreground="#E9C46A"/>
                <TextBlock x:Name="EngineDetailText" Text="Đang chuẩn bị Engine..." Classes="muted" TextWrapping="Wrap"/>
                <TextBlock x:Name="LastHeartbeatText" Text="Heartbeat: —" Classes="muted"/>
              </StackPanel>

              <StackPanel Grid.Column="2" Spacing="7">
                <TextBlock Text="MT5 Bridge" Classes="muted"/>
                <TextBlock x:Name="BridgeStateText" Text="WAITING" FontSize="19" FontWeight="SemiBold" Foreground="#E9C46A"/>
                <TextBlock x:Name="BridgeDetailText" Text="Chưa nhận snapshot từ XAUPY_Bridge_EA." Classes="muted" TextWrapping="Wrap"/>
                <TextBlock x:Name="BridgeGuardianText" Text="Guardian: TASK003_EXECUTION_LOCKED" Foreground="#E9C46A" TextWrapping="Wrap"/>
              </StackPanel>
            </Grid>
          </Border>

          <Grid ColumnDefinitions="2*,*" ColumnSpacing="18">
            <Border Grid.Column="0" Classes="card" MinHeight="330">
              <StackPanel Spacing="14">
                <TextBlock Text="MT5 Data Channel" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="127.0.0.1:39421 • bridge_snapshot • M1/M3/M5/M15/M30/H1/H2/H4" Foreground="#59D9FF"/>
                <TextBlock Text="EA gửi account, symbol, bid/ask, spread, broker volume/stop rules, vị thế/lệnh thuộc magic và nến đóng gần nhất của 8 timeframe. Engine đánh dấu Bridge offline nếu snapshot bị stale."
                           Classes="muted" TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <Button Classes="action" Content="Khởi động Engine" Click="StartEngine_OnClick"/>
                  <Button Classes="action" Content="Dừng Engine" Click="StopEngine_OnClick"/>
                </StackPanel>

                <Border Background="#091421" CornerRadius="8" Padding="18" Margin="0,8,0,0">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Execution Guardian — Task 003" FontWeight="SemiBold"/>
                    <TextBlock Text="✓ EA chỉ kết nối loopback" Foreground="#69D48C"/>
                    <TextBlock Text="✓ execution_locked=true bắt buộc" Foreground="#69D48C"/>
                    <TextBlock Text="✓ execution_ready=false bắt buộc" Foreground="#69D48C"/>
                    <TextBlock Text="✓ Không tồn tại OrderSend/CTrade trong EA Task 003" Foreground="#69D48C"/>
                    <TextBlock Text="✓ Demo/lot/daily-loss/positions/broker rules được thu thập cho task thực thi sau" Foreground="#69D48C" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <Border Grid.Column="1" Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Text="Build Task 003" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="✓ Python bridge protocol" Foreground="#69D48C"/>
                <TextBlock Text="✓ Avalonia bridge status" Foreground="#69D48C"/>
                <TextBlock Text="✓ MQL5 source" Foreground="#69D48C"/>
                <TextBlock Text="• MetaEditor compile / CI" Foreground="#E9C46A"/>
                <TextBlock Text="• XAUPY_Bridge_EA.ex5 artifact" Foreground="#E9C46A"/>
                <TextBlock Text="Trading: HARD LOCKED" Classes="muted" Margin="0,12,0,0"/>
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="2" Background="#081321" BorderBrush="#183554" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto" Margin="18,0">
        <TextBlock Text="XAUPY • MT5 bridge data only • execution locked" Classes="muted" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="TASK XAUPY-003" Foreground="#59D9FF" VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </Grid>
</Window>
