<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XAUPY.Desktop"
             x:Class="XAUPY.Desktop.MonitoringDashboard">
  <UserControl.Styles>
    <Style Selector="Grid.timeframeTable > TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
    </Style>
  </UserControl.Styles>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="8">
      <Grid ColumnDefinitions="2.35*,1*" ColumnSpacing="8">
        <!-- Main market chart -->
        <Border Grid.Column="0" Classes="panel" Height="318">
          <Grid RowDefinitions="42,*,27">
            <Grid Grid.Row="0" Background="#082038" ColumnDefinitions="Auto,*,Auto" Margin="12,0">
              <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="XAUUSD" FontSize="17" FontWeight="Bold"/>
                <TextBlock Text="M5" FontSize="17" FontWeight="Bold"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="25,0,0,0" Spacing="5" VerticalAlignment="Center">
                <Border Classes="panelSoft" Padding="7,4"><TextBlock Text="M1"/></Border>
                <Border Background="#0866F4" BorderBrush="#2A8EFF" BorderThickness="1" CornerRadius="4" Padding="7,4"><TextBlock Text="M5"/></Border>
                <Border Classes="panelSoft" Padding="7,4"><TextBlock Text="M15"/></Border>
                <Border Classes="panelSoft" Padding="7,4"><TextBlock Text="M30"/></Border>
                <Border Classes="panelSoft" Padding="7,4"><TextBlock Text="H1"/></Border>
                <Border Classes="panelSoft" Padding="7,4"><TextBlock Text="H4"/></Border>
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <TextBlock Text="+ So sánh" Classes="label"/>
                <TextBlock Text="ƒ  Chỉ báo" Classes="label"/>
                <TextBlock Text="Nến Nhật" Classes="label"/>
              </StackPanel>
            </Grid>

            <local:MarketChartControl x:Name="MonitoringMarketChart" Grid.Row="1" Grid.RowSpan="2"/>
            <StackPanel IsVisible="False">
              <TextBlock x:Name="ChartLastText"/><TextBlock x:Name="ChartRangeText"/>
              <TextBlock x:Name="MonitorBidText"/><TextBlock x:Name="MonitorAskText"/>
              <TextBlock x:Name="ChartMinText"/><TextBlock x:Name="ChartMaxText"/>
              <StackPanel x:Name="QuoteChartBars"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Approved multi-timeframe condition table -->
        <Border Grid.Column="1" Classes="panel" Height="318">
          <StackPanel>
            <Border Background="#082038" Padding="12,8">
              <TextBlock Text="Trạng thái điều kiện đa khung thời gian" Classes="panelTitle"/>
            </Border>
            <Grid Classes="timeframeTable" Margin="10,8" ColumnDefinitions="0.65*,0.8*,1.05*,1.15*,1*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="9">
              <TextBlock Grid.Row="0" Text="Khung" Classes="dim" FontSize="12"/>
              <TextBlock Grid.Row="0" Grid.Column="1" Text="Direction" Classes="dim" FontSize="12"/>
              <TextBlock Grid.Row="0" Grid.Column="2" Text="Pullback" Classes="dim" FontSize="12"/>
              <TextBlock Grid.Row="0" Grid.Column="3" Text="Trigger" Classes="dim" FontSize="12"/>
              <TextBlock Grid.Row="0" Grid.Column="4" Text="Trạng thái" Classes="dim" FontSize="12"/>

              <TextBlock Grid.Row="1" x:Name="MonitorDirectionTfText" Text="M30"/>
              <TextBlock Grid.Row="1" Grid.Column="1" x:Name="MonitorDirectionStateText" Text="NEUTRAL"/>
              <TextBlock Grid.Row="1" Grid.Column="2" Text="—"/>
              <TextBlock Grid.Row="1" Grid.Column="3" Text="—"/>
              <TextBlock Grid.Row="1" Grid.Column="4" Text="Chờ dữ liệu" Foreground="#86A0BA"/>

              <TextBlock Grid.Row="2" x:Name="MonitorPullbackTfText" Text="M5"/>
              <TextBlock Grid.Row="2" Grid.Column="1" Text="—"/>
              <TextBlock Grid.Row="2" Grid.Column="2" x:Name="MonitorPullbackStateText" Text="WAIT"/>
              <TextBlock Grid.Row="2" Grid.Column="3" Text="—"/>
              <TextBlock Grid.Row="2" Grid.Column="4" Text="Chờ dữ liệu" Foreground="#86A0BA"/>

              <TextBlock Grid.Row="3" x:Name="MonitorTriggerTfText" Text="M1"/>
              <TextBlock Grid.Row="3" Grid.Column="1" Text="—"/>
              <TextBlock Grid.Row="3" Grid.Column="2" Text="—"/>
              <TextBlock Grid.Row="3" Grid.Column="3" x:Name="MonitorTriggerStateText" Text="WAIT"/>
              <TextBlock Grid.Row="3" Grid.Column="4" Text="Chờ dữ liệu" Foreground="#86A0BA"/>

              <TextBlock Grid.Row="4" Text="M15" Classes="dim"/>
              <TextBlock Grid.Row="4" Grid.Column="1" Text="—" Classes="dim"/>
              <TextBlock Grid.Row="4" Grid.Column="2" Text="—" Classes="dim"/>
              <TextBlock Grid.Row="4" Grid.Column="3" Text="—" Classes="dim"/>
              <TextBlock Grid.Row="4" Grid.Column="4" Text="Chưa xét" Classes="dim"/>

              <TextBlock Grid.Row="5" Text="H1" Classes="dim" FontSize="11"/>
              <TextBlock Grid.Row="5" Grid.Column="1" Text="—" Classes="dim" FontSize="11"/>
              <TextBlock Grid.Row="5" Grid.Column="2" Text="—" Classes="dim" FontSize="11"/>
              <TextBlock Grid.Row="5" Grid.Column="3" Text="—" Classes="dim" FontSize="11"/>
              <TextBlock Grid.Row="5" Grid.Column="4" Text="Chưa xét" Classes="dim"/>

              <TextBlock Grid.Row="6" Text="H4" Classes="dim"/>
              <TextBlock Grid.Row="6" Grid.Column="1" Text="—" Classes="dim"/>
              <TextBlock Grid.Row="6" Grid.Column="2" Text="—" Classes="dim"/>
              <TextBlock Grid.Row="6" Grid.Column="3" Text="—" Classes="dim"/>
              <TextBlock Grid.Row="6" Grid.Column="4" Text="Chưa xét" Classes="dim"/>
            </Grid>
          </StackPanel>
        </Border>
      </Grid>

      <Grid ColumnDefinitions="2.35*,1*" ColumnSpacing="8">
        <!-- Indicator cards -->
        <Border Grid.Column="0" Classes="panel">
          <StackPanel>
            <Border Background="#082038" Padding="12,7"><TextBlock Text="Chỉ báo &amp; Thị trường (Realtime)" Classes="panelTitle"/></Border>
            <Grid ColumnDefinitions="*,*,*,*,*,*,*,*" ColumnSpacing="7" Margin="10,8">
              <Border Grid.Column="0" Classes="panelSoft" Padding="5">
                <StackPanel HorizontalAlignment="Center">
                  <TextBlock Text="Z-Score" Classes="label"/>
                  <Border Width="65" Height="35" CornerRadius="37,37,0,0" BorderBrush="#4C9BFF" BorderThickness="7,7,7,0" Margin="0,8,0,0"/>
                  <TextBlock x:Name="MonitorPbZText" Text="—" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                  <TextBlock Text="Pullback" Classes="dim" FontSize="12"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="panelSoft" Padding="5">
                <StackPanel HorizontalAlignment="Center">
                  <TextBlock Text="RSI" Classes="label"/>
                  <Border Width="65" Height="35" CornerRadius="37,37,0,0" BorderBrush="#5BA9FF" BorderThickness="7,7,7,0" Margin="0,8,0,0"/>
                  <TextBlock x:Name="MonitorTriggerRsiText" Text="—" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                  <TextBlock Text="Trigger" Classes="dim" FontSize="12"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Classes="panelSoft" Padding="5">
                <StackPanel HorizontalAlignment="Center">
                  <TextBlock Text="ADX" Classes="label"/>
                  <Border Width="65" Height="35" CornerRadius="37,37,0,0" BorderBrush="#8EA9CC" BorderThickness="7,7,7,0" Margin="0,8,0,0"/>
                  <TextBlock x:Name="MonitorAdxText" Text="—" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                  <TextBlock Text="Trend" Classes="dim" FontSize="12"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="3" Classes="panelSoft" Padding="5">
                <StackPanel HorizontalAlignment="Center">
                  <TextBlock Text="ATR" Classes="label"/>
                  <Border Width="65" Height="35" CornerRadius="37,37,0,0" BorderBrush="#8EA9CC" BorderThickness="7,7,7,0" Margin="0,8,0,0"/>
                  <TextBlock x:Name="MonitorAtrText" Text="—" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                  <TextBlock Text="Volatility" Classes="dim" FontSize="12"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="4" Classes="panelSoft" Padding="5">
                <StackPanel HorizontalAlignment="Center" Spacing="5">
                  <TextBlock Text="MA" Classes="label"/>
                  <TextBlock x:Name="MonitorMaText" Text="—" FontSize="19" FontWeight="Bold"/>
                  <TextBlock Text="Direction" Classes="dim" FontSize="12"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="5" Classes="panelSoft" Padding="5">
                <StackPanel HorizontalAlignment="Center" Spacing="5">
                  <TextBlock Text="Latency" Classes="label"/>
                  <TextBlock x:Name="MonitorAgeText" Text="—" FontSize="19" FontWeight="Bold"/>
                  <TextBlock Text="ms" Classes="dim" FontSize="12"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="6" Classes="panelSoft" Padding="5">
                <StackPanel HorizontalAlignment="Center" Spacing="5">
                  <TextBlock Text="Strategy" Classes="label"/>
                  <TextBlock x:Name="MonitorStrategyText" Text="STALE" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"/>
                  <TextBlock x:Name="MonitorDirectionText" Text="Direction: NEUTRAL" Classes="dim" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="7" Classes="panelSoft" Padding="5">
                <StackPanel HorizontalAlignment="Center" Spacing="5">
                  <TextBlock Text="Bridge" Classes="label"/>
                  <TextBlock x:Name="MonitorBridgeText" Text="WAITING" FontSize="15" FontWeight="Bold"/>
                  <TextBlock Text="Realtime" Classes="dim" FontSize="12"/>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Connection -->
        <Border Grid.Column="1" Classes="panel">
          <StackPanel>
            <Border Background="#082038" Padding="12,7"><TextBlock Text="Kết nối &amp; Engine" Classes="panelTitle"/></Border>
            <Grid Margin="12,8" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
              <TextBlock x:Name="MonitorTerminalDot" Grid.Row="0" Text="●" Foreground="#8092A6" Margin="0,0,8,0"/><TextBlock Grid.Row="0" Grid.Column="1" Text="MT5 Terminal" Classes="label"/><TextBlock x:Name="MonitorTerminalText" Grid.Row="0" Grid.Column="2" Text="offline"/>
              <TextBlock x:Name="MonitorBridgeDot" Grid.Row="1" Text="●" Foreground="#8092A6" Margin="0,0,8,0"/><TextBlock Grid.Row="1" Grid.Column="1" Text="EA Bridge (MQL5)" Classes="label"/><TextBlock Grid.Row="1" Grid.Column="2" Text="Realtime"/>
              <TextBlock x:Name="MonitorEngineDot" Grid.Row="2" Text="●" Foreground="#8092A6" Margin="0,0,8,0"/><TextBlock Grid.Row="2" Grid.Column="1" Text="Python Engine" Classes="label"/><TextBlock x:Name="MonitorSnapshotCountText" Grid.Row="2" Grid.Column="2" Text="Snapshots: 0"/>
              <TextBlock x:Name="MonitorDataDot" Grid.Row="3" Text="●" Foreground="#8092A6" Margin="0,0,8,0"/><TextBlock Grid.Row="3" Grid.Column="1" Text="Profile" Classes="label"/><TextBlock x:Name="MonitorProfileText" Grid.Row="3" Grid.Column="2" Text="Baseline" TextWrapping="Wrap"/>
            </Grid>
          </StackPanel>
        </Border>
      </Grid>

      <Grid ColumnDefinitions="1.65*,0.95*,0.9*" ColumnSpacing="8" Height="184">
        <!-- Session/news panel kept in correct location but honestly unavailable -->
        <Border Grid.Column="0" Classes="panel" MinHeight="176">
          <StackPanel>
            <Border Background="#082038" Padding="12,7"><TextBlock Text="Phiên giao dịch &amp; Tin tức" Classes="panelTitle"/></Border>
            <Grid ColumnDefinitions="0.9*,1.5*" Margin="10,8" ColumnSpacing="10">
              <StackPanel>
                <Border Background="#0866F4" CornerRadius="4" Padding="7,4"><TextBlock Text="Phiên thị trường" HorizontalAlignment="Center"/></Border>
                <Grid Margin="4,7" ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                  <TextBlock Grid.Row="0" Text="Sydney" Classes="label"/><TextBlock Grid.Row="0" Grid.Column="1" Text="—" Classes="dim"/><TextBlock Grid.Row="0" Grid.Column="2" Text="—" Classes="dim"/>
                  <TextBlock Grid.Row="1" Text="Tokyo" Classes="label"/><TextBlock Grid.Row="1" Grid.Column="1" Text="—" Classes="dim"/><TextBlock Grid.Row="1" Grid.Column="2" Text="—" Classes="dim"/>
                  <TextBlock Grid.Row="2" Text="London" Classes="label"/><TextBlock Grid.Row="2" Grid.Column="1" Text="—" Classes="dim"/><TextBlock Grid.Row="2" Grid.Column="2" Text="—" Classes="dim"/>
                  <TextBlock Grid.Row="3" Text="New York" Classes="label"/><TextBlock Grid.Row="3" Grid.Column="1" Text="—" Classes="dim"/><TextBlock Grid.Row="3" Grid.Column="2" Text="—" Classes="dim"/>
                </Grid>
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Tin tức quan trọng (Hôm nay)" FontWeight="SemiBold"/>
                <Border Classes="panelSoft" Margin="0,6,0,0" Padding="12,13">
                  <TextBlock Text="Chưa có lịch tin tức được tải."
                             Classes="dim" TextWrapping="Wrap" TextAlignment="Center"/>
                </Border>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Execution state -->
        <Border Grid.Column="1" Classes="panel">
          <StackPanel>
            <Border Background="#082038" Padding="12,7"><TextBlock Text="Trạng thái thực thi" Classes="panelTitle"/></Border>
            <Grid Margin="12,6" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="2">
              <TextBlock Grid.Row="0" Text="Tổng lệnh hôm nay" Classes="label"/><TextBlock Grid.Row="0" Grid.Column="1" Text="—"/>
              <TextBlock Grid.Row="1" Text="Lệnh đã khớp" Classes="label"/><TextBlock Grid.Row="1" Grid.Column="1" Text="—" Foreground="#18E58B"/>
              <TextBlock Grid.Row="2" Text="Lệnh bị từ chối" Classes="label"/><TextBlock Grid.Row="2" Grid.Column="1" Text="—"/>
              <TextBlock Grid.Row="3" Text="Lệnh chờ xử lý" Classes="label"/><TextBlock Grid.Row="3" Grid.Column="1" Text="—"/>
              <TextBlock Grid.Row="4" Text="Execution" Classes="label"/><TextBlock Grid.Row="4" Grid.Column="1" Text="LOCKED" Foreground="#FFD34D" FontWeight="Bold"/>
            </Grid>
            <TextBlock Text="Giao dịch đang khóa an toàn." Classes="dim" FontSize="10" TextWrapping="Wrap" Margin="12,0,12,8"/>
          </StackPanel>
        </Border>

        <!-- Resources -->
        <Border Grid.Column="2" Classes="panel">
          <StackPanel>
            <Border Background="#082038" Padding="12,7"><TextBlock Text="Tài nguyên hệ thống" Classes="panelTitle"/></Border>
            <Grid ColumnDefinitions="*,*,*" Margin="10,10" ColumnSpacing="8">
              <StackPanel Grid.Column="0" HorizontalAlignment="Center"><Border Width="55" Height="55" CornerRadius="28" BorderBrush="#00B873" BorderThickness="7"><TextBlock Text="—" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border><TextBlock Text="CPU" Classes="dim" FontSize="12" HorizontalAlignment="Center"/></StackPanel>
              <StackPanel Grid.Column="1" HorizontalAlignment="Center"><Border Width="55" Height="55" CornerRadius="28" BorderBrush="#258DEC" BorderThickness="7"><TextBlock Text="—" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border><TextBlock Text="RAM" Classes="dim" FontSize="12" HorizontalAlignment="Center"/></StackPanel>
              <StackPanel Grid.Column="2" HorizontalAlignment="Center"><Border Width="55" Height="55" CornerRadius="28" BorderBrush="#9746F4" BorderThickness="7"><TextBlock Text="—" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border><TextBlock Text="Disk" Classes="dim" FontSize="12" HorizontalAlignment="Center"/></StackPanel>
            </Grid>
            <TextBlock Text="Chưa có dữ liệu tài nguyên hệ thống." Classes="dim" FontSize="12" TextWrapping="Wrap" Margin="10,0,10,8"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- OHLC evidence remains available to the controller and chart. -->
      <Border Classes="panel" IsVisible="False">
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="10,8">
          <Border Grid.Column="0" Classes="panelSoft" Padding="10">
            <StackPanel>
              <TextBlock x:Name="DirectionBarRoleText" Text="DIRECTION • M30" Foreground="#59B7FF" FontWeight="SemiBold"/>
              <TextBlock x:Name="DirectionBarText" Text="OHLC: —" Classes="label" TextWrapping="Wrap"/>
              <TextBlock x:Name="DirectionBarTimeText" Text="Closed: —" Classes="dim" FontSize="12"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="panelSoft" Padding="10">
            <StackPanel>
              <TextBlock x:Name="PullbackBarRoleText" Text="PULLBACK • M5" Foreground="#B67AFF" FontWeight="SemiBold"/>
              <TextBlock x:Name="PullbackBarText" Text="OHLC: —" Classes="label" TextWrapping="Wrap"/>
              <TextBlock x:Name="PullbackBarTimeText" Text="Closed: —" Classes="dim" FontSize="12"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Classes="panelSoft" Padding="10">
            <StackPanel>
              <TextBlock x:Name="TriggerBarRoleText" Text="TRIGGER • M1" Foreground="#18E58B" FontWeight="SemiBold"/>
              <TextBlock x:Name="TriggerBarText" Text="OHLC: —" Classes="label" TextWrapping="Wrap"/>
              <TextBlock x:Name="TriggerBarTimeText" Text="Closed: —" Classes="dim" FontSize="12"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- A compact horizontal alert strip leaves the table visible at the reference canvas size. -->
      <Border x:Name="MonitoringAlertStrip" Classes="panel" Height="91">
        <Grid x:Name="MonitoringAlertColumns" ColumnDefinitions="315,*">
          <StackPanel Margin="12,8" Spacing="8">
            <TextBlock Text="Cảnh báo &amp; Thông báo" Classes="panelTitle"/>
            <Border Background="#0866F4" CornerRadius="4" Padding="10,3" HorizontalAlignment="Left"><TextBlock Text="Tất cả"/></Border>
          </StackPanel>
          <Border Grid.Column="1" BorderBrush="#14517A" BorderThickness="1,0,0,0">
            <Grid RowDefinitions="25,*">
              <Grid Background="#082038" ColumnDefinitions="95,75,100,*" Margin="10,3">
                <TextBlock Text="Thời gian" Classes="dim" FontSize="12"/><TextBlock Grid.Column="1" Text="Mức" Classes="dim" FontSize="12"/><TextBlock Grid.Column="2" Text="Loại" Classes="dim" FontSize="12"/><TextBlock Grid.Column="3" Text="Thông báo" Classes="dim" FontSize="12"/>
              </Grid>
              <Grid Grid.Row="1" ColumnDefinitions="95,75,100,*" Margin="10,4,10,8">
                <TextBlock Text="Realtime" Classes="dim" FontSize="12"/><TextBlock Grid.Column="1" Text="INFO" Foreground="#40BFFF" FontSize="12"/><TextBlock Grid.Column="2" Text="Hệ thống" Classes="label" FontSize="12"/><TextBlock x:Name="MonitorAlertText" Grid.Column="3" Text="Alert: đang chờ Bridge." Foreground="#FFD34D" TextWrapping="Wrap" FontSize="12"/>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
