<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XAUPY.Desktop"
             x:Class="XAUPY.Desktop.OrdersPositionsDashboard">
  <UserControl.Styles>
    <Style Selector="TextBlock.tableHeader">
      <Setter Property="Foreground" Value="#B9CCE0"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Margin" Value="5,6"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="Button.rowAction">
      <Setter Property="Background" Value="#0A54B5"/>
      <Setter Property="Foreground" Value="#EAF4FF"/>
      <Setter Property="BorderBrush" Value="#1677ED"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="9,4"/>
      <Setter Property="MinHeight" Value="27"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Button.dangerAction">
      <Setter Property="Background" Value="#321321"/>
      <Setter Property="Foreground" Value="#FF6A82"/>
      <Setter Property="BorderBrush" Value="#E0264F"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="10,6"/>
    </Style>
    <Style Selector="TextBox.tradeInput">
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="HorizontalContentAlignment" Value="Right"/>
    </Style>
    <Style Selector="Button.quickLot">
      <Setter Property="Padding" Value="5,2"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="4*,1*" ColumnSpacing="8">
    <ScrollViewer Grid.Column="0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="8">
        <!-- Approved five KPI cards -->
        <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="8">
          <Border Grid.Column="0" Classes="panel" Height="106" Padding="12,10">
            <Grid ColumnDefinitions="48,*" ColumnSpacing="12">
              <Border Width="48" Height="48" CornerRadius="24" BorderBrush="#18E58B" BorderThickness="1" VerticalAlignment="Top"><TextBlock Text="$" Foreground="#18E58B" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Text="Tổng P/L đang mở" FontSize="15" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="OpenPlText" Text="—" FontSize="28" FontWeight="Bold" Foreground="#18E58B"/>
                <TextBlock x:Name="OpenPlPercentText" Text="—" Classes="dim" FontSize="13" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Grid>
          </Border>
          <Border Grid.Column="1" Classes="panel" Height="106" Padding="12,10">
            <Grid ColumnDefinitions="48,*" ColumnSpacing="12">
              <Border Width="48" Height="48" CornerRadius="24" BorderBrush="#4C9BFF" BorderThickness="1" VerticalAlignment="Top"><local:ReferenceIcon Kind="bars" Width="27" Height="27" Tint="#4C9BFF"/></Border>
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Text="P/L đã thực hiện" FontSize="15" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="RealizedPlText" Text="—" FontSize="28" FontWeight="Bold" Foreground="#18E58B"/>
                <TextBlock x:Name="RealizedTodayText" Text="Hôm nay: —" Classes="dim" FontSize="13" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Grid>
          </Border>
          <Border Grid.Column="2" Classes="panel" Height="106" Padding="12,10">
            <Grid ColumnDefinitions="48,*" ColumnSpacing="12">
              <Border Width="48" Height="48" CornerRadius="24" BorderBrush="#69A7FF" BorderThickness="1" VerticalAlignment="Top"><Path Data="M12,2 L12,12 22,12 A10,10 0 0 1 2,12 A10,10 0 0 1 12,2 M15,1 A10,10 0 0 1 25,11 L15,11 Z" Stroke="#69A7FF" StrokeThickness="1.5" Fill="#204784" Width="28" Height="28" Stretch="Uniform"/></Border>
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Text="Tổng mức tiếp xúc" FontSize="15" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ExposureText" Text="— lots" FontSize="28" FontWeight="Bold" Foreground="#EAF3FF"/>
                <TextBlock Text="Khối lượng vị thế đang mở" Classes="dim" FontSize="13" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Grid>
          </Border>
          <Border Grid.Column="3" Classes="panel" Height="106" Padding="12,10">
            <Grid ColumnDefinitions="48,*" ColumnSpacing="12">
              <Border Width="48" Height="48" CornerRadius="24" BorderBrush="#68A6FF" BorderThickness="1" VerticalAlignment="Top"><local:ReferenceIcon Kind="shield" Width="27" Height="27" Tint="#68A6FF"/></Border>
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Text="Rủi ro hiện tại" FontSize="15" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="RiskText" Text="—" FontSize="28" FontWeight="Bold" Foreground="#EAF3FF"/>
                <TextBlock x:Name="RiskDetailText" Text="Dựa trên server SL thật" Classes="dim" FontSize="13" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Grid>
          </Border>
          <Border Grid.Column="4" Classes="panel" Height="106" Padding="12,10">
            <Grid ColumnDefinitions="48,*" ColumnSpacing="12">
              <Border Width="48" Height="48" CornerRadius="24" BorderBrush="#70AFFF" BorderThickness="1" VerticalAlignment="Top"><local:ReferenceIcon Kind="document" Width="27" Height="27" Tint="#70AFFF"/></Border>
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Text="Lệnh chờ đang hoạt động" FontSize="14" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="PendingCountText" Text="0" FontSize="28" FontWeight="Bold" Foreground="#EAF3FF"/>
                <TextBlock x:Name="PendingTypesText" Text="—" Classes="dim" FontSize="13" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>

        <Border x:Name="DemoOnceStatusPanel" Classes="panel" IsVisible="False" Padding="10,5">
          <TextBlock x:Name="DemoOnceStatusText" FontSize="13" TextTrimming="CharacterEllipsis"/>
        </Border>

        <!-- Open positions -->
        <Border Classes="panel" MinHeight="194">
          <StackPanel>
            <Grid Background="#082038" ColumnDefinitions="*,Auto" Margin="0">
              <TextBlock x:Name="PositionsTitleText" Text="Vị thế đang mở (0)" Classes="panelTitle" Margin="12,8"/>
              <CheckBox x:Name="ShowAllSymbolsCheck" Grid.Column="1" Content="Hiển thị tất cả symbol" IsChecked="True" Margin="0,0,12,0" VerticalAlignment="Center"/>
            </Grid>
            <Grid Margin="10,0,10,0" ColumnDefinitions="0.38*,0.92*,0.78*,0.68*,0.76*,0.86*,0.86*,0.76*,0.76*,0.96*,0.86*,0.92*,1.26*,2*">
              <TextBlock Text="#" Classes="tableHeader"/>
              <TextBlock Grid.Column="1" Text="Ticket" Classes="tableHeader"/>
              <TextBlock Grid.Column="2" Text="Symbol" Classes="tableHeader"/>
              <TextBlock Grid.Column="3" Text="Loại" Classes="tableHeader"/>
              <TextBlock Grid.Column="4" Text="Lot" Classes="tableHeader"/>
              <TextBlock Grid.Column="5" Text="Giá vào" Classes="tableHeader"/>
              <TextBlock Grid.Column="6" Text="Giá hiện tại" Classes="tableHeader"/>
              <TextBlock Grid.Column="7" Text="SL" Classes="tableHeader"/>
              <TextBlock Grid.Column="8" Text="TP" Classes="tableHeader"/>
              <TextBlock Grid.Column="9" Text="P/L (USD)" Classes="tableHeader"/>
              <TextBlock Grid.Column="10" Text="P/L (pips)" Classes="tableHeader"/>
              <TextBlock Grid.Column="11" Text="Trạng thái" Classes="tableHeader"/>
              <TextBlock Grid.Column="12" Text="Thời gian" Classes="tableHeader"/>
              <TextBlock Grid.Column="13" Text="Thao tác" Classes="tableHeader" HorizontalAlignment="Center"/>
            </Grid>
            <StackPanel x:Name="PositionsRowsHost" Margin="8,0,8,7"/>
          </StackPanel>
        </Border>

        <!-- Active pending orders -->
        <Border Classes="panel" MinHeight="194">
          <StackPanel>
            <Border Background="#082038" Padding="12,8">
              <TextBlock x:Name="PendingTitleText" Text="Lệnh chờ đang hoạt động (0)" Classes="panelTitle"/>
            </Border>
            <Grid Margin="10,0,10,0" ColumnDefinitions="0.38*,0.92*,0.82*,0.92*,0.74*,0.92*,0.78*,0.78*,1.2*,1*,1.3*,1.8*">
              <TextBlock Text="#" Classes="tableHeader"/>
              <TextBlock Grid.Column="1" Text="Ticket" Classes="tableHeader"/>
              <TextBlock Grid.Column="2" Text="Symbol" Classes="tableHeader"/>
              <TextBlock Grid.Column="3" Text="Loại" Classes="tableHeader"/>
              <TextBlock Grid.Column="4" Text="Lot" Classes="tableHeader"/>
              <TextBlock Grid.Column="5" Text="Giá đặt" Classes="tableHeader"/>
              <TextBlock Grid.Column="6" Text="SL" Classes="tableHeader"/>
              <TextBlock Grid.Column="7" Text="TP" Classes="tableHeader"/>
              <TextBlock Grid.Column="8" Text="Khoảng cách" Classes="tableHeader"/>
              <TextBlock Grid.Column="9" Text="Trạng thái" Classes="tableHeader"/>
              <TextBlock Grid.Column="10" Text="Thời gian" Classes="tableHeader"/>
              <TextBlock Grid.Column="11" Text="Thao tác" Classes="tableHeader" HorizontalAlignment="Center"/>
            </Grid>
            <StackPanel x:Name="PendingRowsHost" Margin="8,0,8,7"/>
          </StackPanel>
        </Border>

        <!-- Bulk actions exactly in reference order -->
        <Border Classes="panel" Padding="10,6">
          <StackPanel Spacing="2">
            <UniformGrid Columns="7">
              <Button Classes="dangerAction" Content="◉  Đóng tất cả vị thế" Tag="CLOSE_ALL" FontSize="14" Padding="5,7" Click="BulkAction_OnClick" Margin="0,0,8,5"/>
              <Button Classes="secondary" Content="$  Đóng lãi" Tag="CLOSE_PROFIT" Click="BulkAction_OnClick" Margin="0,0,8,5"/>
              <Button Classes="secondary" Content="▥  Đóng lỗ" Tag="CLOSE_LOSS" Click="BulkAction_OnClick" Margin="0,0,8,5"/>
              <Button Classes="secondary" Content="◔  Đóng một phần" Tag="PARTIAL_ALL" Click="BulkAction_OnClick" Margin="0,0,8,5"/>
              <Button Classes="secondary" Content="⬟  Chuyển SL về BE" Tag="BE_ALL" Click="BulkAction_OnClick" Margin="0,0,8,5"/>
              <Button Classes="secondary" Content="⌁  Trailing Stop" Tag="TRAIL_ALL" Click="BulkAction_OnClick" Margin="0,0,8,5"/>
              <Button Classes="dangerAction" Content="⊘  Hủy tất cả lệnh chờ" Tag="CANCEL_ALL_PENDING" FontSize="14" Padding="5,7" Click="BulkAction_OnClick" Margin="0,0,0,5"/>
            </UniformGrid>
            <Grid ColumnDefinitions="Auto,*">
              <CheckBox x:Name="ConfirmCloseCheck" MinHeight="23" FontSize="13" Content="Xác nhận trước khi đóng / sửa / hủy"/>
              <TextBlock x:Name="ActionStatusText"
                         Grid.Column="1" FontSize="13" VerticalAlignment="Center"
                         Text="SIMULATION ONLY • broker execution locked"
                         Foreground="#FFD34D"
                         HorizontalAlignment="Right"
                         TextWrapping="Wrap"/>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Deal history -->
        <Border Classes="panel" MinHeight="180">
          <StackPanel>
            <Grid Background="#082038" ColumnDefinitions="*,Auto,Auto">
              <TextBlock Text="Lịch sử giao dịch (Deals)" Classes="panelTitle" Margin="12,8"/>
              <CheckBox Grid.Column="1" Content="Hiển thị symbol hiện tại" IsChecked="True" Margin="0,0,14,0" VerticalAlignment="Center"/>
              <Button Grid.Column="2" Classes="secondary" Content="⬇  Xuất báo cáo" IsEnabled="False" Margin="0,4,10,4"/>
            </Grid>
            <Grid Margin="10,0,10,0" ColumnDefinitions="0.92*,1.45*,0.86*,0.7*,0.76*,0.94*,0.94*,1*,0.94*,0.92*,2.2*">
              <TextBlock Text="#" Classes="tableHeader"/>
              <TextBlock Grid.Column="1" Text="Thời gian" Classes="tableHeader"/>
              <TextBlock Grid.Column="2" Text="Symbol" Classes="tableHeader"/>
              <TextBlock Grid.Column="3" Text="Loại" Classes="tableHeader"/>
              <TextBlock Grid.Column="4" Text="Lot" Classes="tableHeader"/>
              <TextBlock Grid.Column="5" Text="Giá vào" Classes="tableHeader"/>
              <TextBlock Grid.Column="6" Text="Giá ra" Classes="tableHeader"/>
              <TextBlock Grid.Column="7" Text="P/L (USD)" Classes="tableHeader"/>
              <TextBlock Grid.Column="8" Text="Commission" Classes="tableHeader"/>
              <TextBlock Grid.Column="9" Text="Swap" Classes="tableHeader"/>
              <TextBlock Grid.Column="10" Text="Lý do / Comment" Classes="tableHeader"/>
            </Grid>
            <StackPanel x:Name="DealsRowsHost" Margin="8,0,8,7"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Right market/manual control rail -->
    <ScrollViewer Grid.Column="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="6">
        <Border Classes="panel" Padding="12,9">
          <StackPanel Spacing="3">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock x:Name="OrdersSymbolText" Text="XAUUSD" FontSize="22" FontWeight="Bold" Foreground="#CBE0F8"/>
              <TextBlock x:Name="OrdersConnectionDot" IsVisible="False" Foreground="#8092A6"/>
              <Ellipse Width="16" Height="16" Fill="{Binding #OrdersConnectionDot.Foreground}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="OrdersLastPriceText" Text="—" FontSize="36" FontWeight="Bold" Foreground="#18E58B"/>
            <TextBlock x:Name="OrdersChangeText" Text="—" FontSize="20" FontWeight="Bold" Foreground="#FF415C"/>
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
              <TextBlock Text="Bid" Foreground="#18E58B"/>
              <TextBlock x:Name="OrdersBidText" Grid.Column="1" Text="—" HorizontalAlignment="Center"/>
              <TextBlock Grid.Column="2" Text="Ask" Foreground="#18E58B" Margin="0,0,8,0"/>
              <TextBlock x:Name="OrdersAskText" Grid.Column="3" Text="—"/>
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="panel">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5" Margin="8,7,8,5">
              <Border Classes="panelSoft" Padding="9,5"><TextBlock Text="M1"/></Border>
              <Border Background="#0866F4" CornerRadius="4" Padding="9,5"><TextBlock Text="M5"/></Border>
              <Border Classes="panelSoft" Padding="9,5"><TextBlock Text="M15"/></Border>
              <Border Classes="panelSoft" Padding="9,5"><TextBlock Text="M30"/></Border>
              <Border Classes="panelSoft" Padding="9,5"><TextBlock Text="H1"/></Border>
              <Border Classes="panelSoft" Padding="9,5"><TextBlock Text="H4"/></Border>
            </StackPanel>
            <Grid Height="273">
              <local:MarketChartControl x:Name="OrdersMarketChart"/>
              <StackPanel IsVisible="False"><TextBlock x:Name="OrdersChartLastText"/><StackPanel x:Name="OrdersChartBars"/></StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="panel">
          <StackPanel>
            <Grid ColumnDefinitions="*,*,*" Background="#082038">
              <Border Grid.Column="0" Background="#0866F4" CornerRadius="4,4,0,0" Margin="4,4,2,0" Padding="9,6"><TextBlock Text="Thị trường" HorizontalAlignment="Center"/></Border>
              <Button Grid.Column="1" Classes="navTab" Content="Lệnh chờ" IsEnabled="False"/>
              <Button Grid.Column="2" Classes="navTab" Content="Thông tin" IsEnabled="False"/>
            </Grid>

            <StackPanel Margin="10,5" Spacing="5">
              <Border Background="#2F2915" BorderBrush="#6A5C24" BorderThickness="1" CornerRadius="4" Padding="4,1">
                <TextBlock Text="CHẾ ĐỘ MÔ PHỎNG • GIAO DỊCH ĐANG KHÓA" Foreground="#FFD34D" FontWeight="Bold" FontSize="12" TextAlignment="Center"/>
              </Border>

              <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                <TextBlock Grid.Row="0" Text="Lot" Classes="label" VerticalAlignment="Center"/>
                <TextBox x:Name="ManualLotBox" Grid.Row="0" Grid.Column="1" Classes="tradeInput" MinHeight="29" Text="0.01"/>
                <TextBlock Grid.Row="1" Text="SL (points)" Classes="label" VerticalAlignment="Center"/>
                <TextBox x:Name="ManualSlBox" Grid.Row="1" Grid.Column="1" Classes="tradeInput" MinHeight="29" PlaceholderText="Bắt buộc"/>
                <TextBlock Grid.Row="2" Text="TP (points)" Classes="label" VerticalAlignment="Center"/>
                <TextBox x:Name="ManualTpBox" Grid.Row="2" Grid.Column="1" Classes="tradeInput" MinHeight="29" PlaceholderText="Tùy chọn"/>
              </Grid>

              <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="5">
                <Button Grid.Column="0" Classes="secondary quickLot" Content="0.01" Tag="0.01" Click="QuickLot_OnClick"/>
                <Button Grid.Column="1" Classes="secondary quickLot" Content="0.05" Tag="0.05" Click="QuickLot_OnClick"/>
                <Button Grid.Column="2" Classes="secondary quickLot" Content="0.10" Tag="0.10" Click="QuickLot_OnClick"/>
                <Button Grid.Column="3" Classes="secondary quickLot" Content="0.50" Tag="0.50" Click="QuickLot_OnClick"/>
                <Button Grid.Column="4" Classes="secondary quickLot" Content="1.00" Tag="1.00" Click="QuickLot_OnClick"/>
              </Grid>

              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button x:Name="MarketBuyButton" HorizontalAlignment="Stretch" Grid.Column="0" Background="#08B966" BorderBrush="#16E18A" BorderThickness="1" CornerRadius="5" Padding="12,6" Click="MarketBuy_OnClick">
                  <StackPanel><TextBlock Text="BUY" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock x:Name="BuyPriceText" Text="—" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel>
                </Button>
                <Button x:Name="MarketSellButton" HorizontalAlignment="Stretch" Grid.Column="1" Background="#E51E45" BorderBrush="#FF4667" BorderThickness="1" CornerRadius="5" Padding="12,6" Click="MarketSell_OnClick">
                  <StackPanel><TextBlock Text="SELL" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock x:Name="SellPriceText" Text="—" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel>
                </Button>
              </Grid>

              <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="ManualSpreadText" Text="Spread: —" Classes="dim"/>
                <CheckBox x:Name="ManualConfirmCheck" Grid.Column="1" MinHeight="23" Height="23" Padding="5,0" FontSize="13" Content="Xác nhận lệnh mô phỏng"/>
              </Grid>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
