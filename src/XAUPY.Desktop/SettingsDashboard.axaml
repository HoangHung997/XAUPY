          <TextBlock Text="{DynamicResource Text_dabaac51a42bc4fc}"/><ComboBox SelectedIndex="0" FontSize="{DynamicResource Font_14}"><ComboBoxItem Content="{DynamicResource Text_13cb8cc0d5e8ddc3}"/></ComboBox>
