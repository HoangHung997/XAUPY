<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:XAUPY.Desktop" x:Class="XAUPY.Desktop.SettingsDashboard">
  <UserControl.Styles>
    <Style Selector="CheckBox"><Setter Property="MinHeight" Value="26"/><Setter Property="Height" Value="26"/></Style>
    <Style Selector="Button.settingsFooter"><Setter Property="Padding" Value="10,4"/><Setter Property="Height" Value="30"/><Setter Property="FontSize" Value="{DynamicResource Font_14}"/></Style>
    <Style Selector="ToggleSwitch.settingsToggle"><Setter Property="OffContent" Value=""/><Setter Property="OnContent" Value=""/><Setter Property="MinWidth" Value="42"/><Setter Property="Width" Value="42"/><Setter Property="MinHeight" Value="26"/><Setter Property="Height" Value="26"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/></Style>
    <Style Selector="TextBox"><Setter Property="MinHeight" Value="30"/><Setter Property="FontSize" Value="{DynamicResource Font_14}"/></Style>
    <Style Selector="ComboBox"><Setter Property="MinHeight" Value="30"/></Style>
    <Style Selector="Button.folderAction"><Setter Property="Width" Value="34"/><Setter Property="Height" Value="31"/><Setter Property="Padding" Value="5"/></Style>
  </UserControl.Styles>
  <Grid RowDefinitions="72,*,30" RowSpacing="6">
