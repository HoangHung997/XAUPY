<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="XAUPY.Desktop.StrategyDashboard">
  <ScrollViewer>
    <StackPanel Spacing="14">
      <Grid ColumnDefinitions="1.1*,1*,1*,1.35*" ColumnSpacing="10">
        <Border Grid.Column="0" Background="#0C1929" BorderBrush="#193956" BorderThickness="1" CornerRadius="10" Padding="14">
          <StackPanel Spacing="4">
            <TextBlock Text="STRATEGY STATE" Foreground="#7890A8" FontSize="11"/>
            <TextBlock x:Name="StrategyStateText" Text="STALE" FontSize="21" FontWeight="SemiBold" Foreground="#E9C46A"/>
            <TextBlock x:Name="BlockedReasonText" Text="BRIDGE_STALE" Foreground="#8097AE" FontSize="12" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Background="#0C1929" BorderBrush="#193956" BorderThickness="1" CornerRadius="10" Padding="14">
          <StackPanel Spacing="4">
            <TextBlock Text="PROFILE" Foreground="#7890A8" FontSize="11"/>
            <TextBlock x:Name="ProfileText" Text="Baseline" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="ProfileHashText" Text="Hash: —" Foreground="#8097AE" FontSize="11"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Background="#0C1929" BorderBrush="#193956" BorderThickness="1" CornerRadius="10" Padding="14">
          <StackPanel Spacing="4">
            <TextBlock Text="DIRECTION" Foreground="#7890A8" FontSize="11"/>
            <TextBlock x:Name="DirectionText" Text="NEUTRAL" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="ArmedSideText" Text="Armed: —" Foreground="#8097AE" FontSize="12"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="3" Background="#302B17" BorderBrush="#6A5C24" BorderThickness="1" CornerRadius="10" Padding="14">
          <StackPanel Spacing="4">
            <TextBlock Text="BROKER SAFETY" Foreground="#CDBA73" FontSize="11"/>
            <TextBlock Text="EXECUTION LOCKED" Foreground="#E9C46A" FontWeight="Bold" FontSize="18"/>
            <TextBlock Text="Task 008 chỉ hiển thị state/signal; không gửi lệnh." Foreground="#AFA374" FontSize="11" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </Grid>

      <Grid ColumnDefinitions="2*,1*" ColumnSpacing="14">
        <StackPanel Grid.Column="0" Spacing="14">
          <Border Background="#0C1929" BorderBrush="#193956" BorderThickness="1" CornerRadius="10" Padding="16">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Direction → Pullback → Trigger" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="ACTIVE PROFILE • READ ONLY" Foreground="#59D9FF" FontSize="11"/>
              </Grid>

              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <Border Grid.Column="0" Background="#091827" BorderBrush="#1E466B" BorderThickness="1" CornerRadius="8" Padding="13">
                  <StackPanel Spacing="6">
                    <TextBlock Text="01  DIRECTION" Foreground="#59D9FF" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DirectionTfText" Text="M30" FontSize="24" FontWeight="Bold"/>
                    <TextBlock x:Name="DirectionRuleText" Text="EMA50" Foreground="#B9CBE0"/>
                    <TextBlock x:Name="DirectionMaText" Text="MA: —" Foreground="#8097AE"/>
                    <TextBlock x:Name="DirectionOpenText" Text="Open ref: —" Foreground="#8097AE"/>
                  </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#091827" BorderBrush="#1E466B" BorderThickness="1" CornerRadius="8" Padding="13">
                  <StackPanel Spacing="6">
                    <TextBlock Text="02  PULLBACK" Foreground="#B99CFF" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PullbackTfText" Text="M5" FontSize="24" FontWeight="Bold"/>
                    <TextBlock x:Name="PullbackRsiText" Text="RSI: —" Foreground="#B9CBE0"/>
                    <TextBlock x:Name="PullbackZText" Text="Z: —" Foreground="#8097AE"/>
                    <TextBlock x:Name="PullbackConditionText" Text="BUY — • SELL —" Foreground="#8097AE"/>
                  </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#091827" BorderBrush="#1E466B" BorderThickness="1" CornerRadius="8" Padding="13">
                  <StackPanel Spacing="6">
                    <TextBlock Text="03  TRIGGER" Foreground="#69D48C" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TriggerTfText" Text="M1" FontSize="24" FontWeight="Bold"/>
                    <TextBlock x:Name="TriggerRsiText" Text="RSI: —" Foreground="#B9CBE0"/>
                    <TextBlock x:Name="TriggerZText" Text="Z: —" Foreground="#8097AE"/>
                    <TextBlock x:Name="TriggerConditionText" Text="Reversal: —" Foreground="#8097AE"/>
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
          </Border>

          <Border Background="#0C1929" BorderBrush="#193956" BorderThickness="1" CornerRadius="10" Padding="16">
            <StackPanel Spacing="10">
              <TextBlock Text="Bộ lọc &amp; chỉ báo realtime" FontSize="17" FontWeight="SemiBold"/>
              <TextBlock Text="Chỉ hiển thị giá trị Python Strategy Engine thực sự tính được. Dấu — nghĩa là disabled, chưa warm-up hoặc chưa có reference bar."
                         Foreground="#8097AE" FontSize="12" TextWrapping="Wrap"/>
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <Border Grid.Column="0" Background="#091827" CornerRadius="8" Padding="12">
                  <StackPanel>
                    <TextBlock Text="ADX" Foreground="#7890A8" FontSize="11"/>
                    <TextBlock x:Name="AdxText" Text="—" FontSize="20" FontWeight="SemiBold"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#091827" CornerRadius="8" Padding="12">
                  <StackPanel>
                    <TextBlock Text="ATR" Foreground="#7890A8" FontSize="11"/>
                    <TextBlock x:Name="AtrText" Text="—" FontSize="20" FontWeight="SemiBold"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#091827" CornerRadius="8" Padding="12">
                  <StackPanel>
                    <TextBlock Text="OPEN REFERENCE" Foreground="#7890A8" FontSize="11"/>
                    <TextBlock x:Name="OpenFilterText" Text="—" FontSize="20" FontWeight="SemiBold"/>
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
          </Border>

          <Border Background="#0C1929" BorderBrush="#193956" BorderThickness="1" CornerRadius="10" Padding="16">
            <StackPanel Spacing="9">
              <TextBlock Text="Warm-up / dữ liệu" FontSize="17" FontWeight="SemiBold"/>
              <TextBlock x:Name="BarsSeenText" Text="Bars: —" Foreground="#B9CBE0" FontFamily="Consolas" TextWrapping="Wrap"/>
              <TextBlock x:Name="WarmupText" Text="Warm-up: chờ dữ liệu thật." Foreground="#8097AE" TextWrapping="Wrap"/>
              <TextBlock x:Name="DataErrorText" Text="Data error: none" Foreground="#8097AE" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="14">
          <Border Background="#0C1929" BorderBrush="#193956" BorderThickness="1" CornerRadius="10" Padding="16">
            <StackPanel Spacing="9">
              <TextBlock Text="Chiến lược hiện tại" FontSize="17" FontWeight="SemiBold"/>
              <TextBlock x:Name="SymbolText" Text="XAUUSD" Foreground="#59D9FF"/>
              <TextBlock x:Name="TimeframeSummaryText" Text="M30 → M5 → M1" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock x:Name="ConfigSummaryText" Text="Direction EMA50" Foreground="#B9CBE0" TextWrapping="Wrap"/>
              <TextBlock x:Name="ResetReasonText" Text="Reset: —" Foreground="#8097AE" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <Border Background="#0C1929" BorderBrush="#193956" BorderThickness="1" CornerRadius="10" Padding="16">
            <StackPanel Spacing="9">
              <TextBlock Text="Trạng thái điều kiện (Realtime)" FontSize="17" FontWeight="SemiBold"/>
              <Grid ColumnDefinitions="1.2*,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                <TextBlock Grid.Row="0" Text="Direction" Foreground="#7890A8"/>
                <TextBlock x:Name="DirectionConditionText" Grid.Row="0" Grid.Column="1" Text="NEUTRAL" HorizontalAlignment="Right"/>
                <TextBlock Grid.Row="1" Text="Pullback" Foreground="#7890A8"/>
                <TextBlock x:Name="PullbackStateText" Grid.Row="1" Grid.Column="1" Text="WAIT" HorizontalAlignment="Right"/>
                <TextBlock Grid.Row="2" Text="Trigger" Foreground="#7890A8"/>
                <TextBlock x:Name="TriggerStateText" Grid.Row="2" Grid.Column="1" Text="WAIT" HorizontalAlignment="Right"/>
                <TextBlock Grid.Row="3" Text="Ready" Foreground="#7890A8"/>
                <TextBlock x:Name="ReadyText" Grid.Row="3" Grid.Column="1" Text="NO" HorizontalAlignment="Right"/>
              </Grid>
            </StackPanel>
          </Border>

          <Border Background="#0C1929" BorderBrush="#193956" BorderThickness="1" CornerRadius="10" Padding="16">
            <StackPanel Spacing="8">
              <TextBlock Text="Tín hiệu gần nhất" FontSize="17" FontWeight="SemiBold"/>
              <TextBlock x:Name="LastSignalText" Text="Chưa có signal." Foreground="#B9CBE0" TextWrapping="Wrap"/>
              <TextBlock x:Name="SignalSequenceText" Text="Sequence: 0" Foreground="#8097AE" FontSize="12"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
