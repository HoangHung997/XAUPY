<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:XAUPY.Desktop" x:Class="XAUPY.Desktop.ToolsDashboard" KeyDown="Tools_OnKeyDown">
  <UserControl.Styles>
    <Style Selector="Button.toolAction"><Setter Property="FontSize" Value="13"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="10,5"/></Style>
    <Style Selector="TextBox.toolField"><Setter Property="Height" Value="36"/><Setter Property="FontSize" Value="14"/></Style>
  </UserControl.Styles>
  <Grid x:Name="ToolsLayout" ColumnDefinitions="330,*,320" ColumnSpacing="9">
    <Border x:Name="ToolNavigation" Classes="panel" Padding="7">
      <Grid RowDefinitions="Auto,*">
        <StackPanel Margin="5,0,0,14" Spacing="5">
          <TextBlock Text="Trung tâm công cụ" FontSize="20" FontWeight="SemiBold" Foreground="#C8E4FF"/>
          <TextBlock Text="Bộ công cụ hỗ trợ vận hành, kiểm tra và quản lý hệ thống" TextWrapping="Wrap" FontSize="14"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1"><StackPanel Spacing="4" x:Name="ToolMenu">
          <Button Classes="secondary" Tag="editor" Click="SelectTool_OnClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="▤   Trình chỉnh sửa cấu hình" FontWeight="SemiBold"/><TextBlock Text="      Sửa file config, tham số EA, chiến lược" FontSize="13"/></StackPanel></Button>
          <Button Classes="secondary" Tag="compare" Click="SelectTool_OnClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="⇄   So sánh Preset" FontWeight="SemiBold"/><TextBlock Text="      So sánh profile đang chạy với mặc định" FontSize="13"/></StackPanel></Button>
          <Button Classes="secondary" Tag="indicators" Click="SelectTool_OnClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="▥   Kiểm tra chỉ báo" FontWeight="SemiBold"/><TextBlock Text="      Probe indicator, tín hiệu và dữ liệu" FontSize="13"/></StackPanel></Button>
          <Button Classes="secondary" Tag="risk" Click="SelectTool_OnClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="▦   Tính toán rủi ro" FontWeight="SemiBold"/><TextBlock Text="      Khoảng SL, tick value và lot size" FontSize="13"/></StackPanel></Button>
          <Button Classes="secondary" Tag="symbol" Click="SelectTool_OnClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="◎   Thông tin Symbol &amp; Phiên" FontWeight="SemiBold"/><TextBlock Text="      Thông số giao dịch, spread, phiên" FontSize="13"/></StackPanel></Button>
          <Button Classes="secondary" Tag="news" Click="SelectTool_OnClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="▤   Kiểm tra file tin tức" FontWeight="SemiBold"/><TextBlock Text="      Kiểm tra lịch tin JSON từ máy" FontSize="13"/></StackPanel></Button>
          <Button Classes="secondary" Tag="diagnostics" Click="SelectTool_OnClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="⌁   Chẩn đoán hệ thống" FontWeight="SemiBold"/><TextBlock Text="      Kiểm tra môi trường, log, kết nối" FontSize="13"/></StackPanel></Button>
          <Button Classes="secondary" Tag="bridge" Click="SelectTool_OnClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="↗   Kiểm tra kết nối Bridge" FontWeight="SemiBold"/><TextBlock Text="      Test kết nối EA Bridge ↔ Python" FontSize="13"/></StackPanel></Button>
          <Button Classes="secondary" Tag="profile" Click="SelectTool_OnClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="♙   Quản lý hồ sơ (Profile)" FontWeight="SemiBold"/><TextBlock Text="      Lưu, tải, sao lưu cấu hình" FontSize="13"/></StackPanel></Button>
          <Button Classes="secondary" Tag="export" Click="SelectTool_OnClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="⇅   Xuất / Nhập dữ liệu" FontWeight="SemiBold"/><TextBlock Text="      Xuất báo cáo, nhập cấu hình JSON" FontSize="13"/></StackPanel></Button>
        </StackPanel></ScrollViewer>
      </Grid>
    </Border>
    <Grid x:Name="ToolWorkspace" Grid.Column="1" RowDefinitions="86,74,*,112" RowSpacing="8">
      <Border Classes="panel" Padding="16,10"><Grid ColumnDefinitions="62,*,150" ColumnSpacing="14"><local:ReferenceIcon x:Name="ToolHeaderIcon" Kind="document" Width="49" Height="49" Tint="#21A8FF"/><StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center"><TextBlock x:Name="ToolTitle" Text="Trình chỉnh sửa cấu hình" FontSize="24" FontWeight="SemiBold" Foreground="#B8E0FF"/><TextBlock x:Name="ToolSubtitle" Text="Chỉnh sửa file cấu hình hệ thống, EA, chiến lược. Hỗ trợ kiểm tra cú pháp và áp dụng nhanh." FontSize="14" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="2" Classes="secondary" Height="42" VerticalAlignment="Top" Click="Help_OnClick"><StackPanel Orientation="Horizontal" Spacing="10"><local:ReferenceIcon Kind="book" Width="22" Height="22"/><TextBlock Text="Hướng dẫn" VerticalAlignment="Center"/></StackPanel></Button></Grid></Border>
      <Grid Grid.Row="1" ColumnDefinitions="1.4*,40,1.1*,1*,1.3*" ColumnSpacing="12" Margin="12,1">
        <StackPanel Spacing="5"><TextBlock Text="Chọn file cấu hình"/><TextBox Classes="toolField" x:Name="ToolFileName" Text="active-profile.json" IsReadOnly="True"/></StackPanel>
        <Button Grid.Column="1" Classes="secondary" Height="36" VerticalAlignment="Bottom" Margin="0,0,0,6" Click="Reload_OnClick" ToolTip.Tip="Tải lại cấu hình từ Engine" Padding="7"><local:ReferenceIcon Kind="refresh" Width="23" Height="23"/></Button>
        <StackPanel Grid.Column="2" Spacing="5"><TextBlock Text="Loại cấu hình"/><ComboBox SelectedIndex="0" Height="36"><ComboBoxItem Content="EA / Trading"/></ComboBox></StackPanel>
        <StackPanel Grid.Column="3" Spacing="5"><TextBlock Text="Symbol"/><TextBox Classes="toolField" x:Name="ToolSymbol" Text="—" IsReadOnly="True"/></StackPanel>
        <StackPanel Grid.Column="4" Spacing="5"><TextBlock Text="Preset hiện tại"/><TextBox Classes="toolField" x:Name="ToolProfileName" Text="—" IsReadOnly="True"/></StackPanel>
      </Grid>
      <Border Grid.Row="2" Classes="panel" Padding="8">
        <Grid RowDefinitions="40,Auto,Auto,*,Auto" RowSpacing="0">
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
            <Button Classes="secondary toolAction" Click="Find_OnClick"><StackPanel Orientation="Horizontal" Spacing="7"><local:ReferenceIcon Kind="search" Width="20" Height="20"/><TextBlock Text="Tìm kiếm" VerticalAlignment="Center"/><Border Background="#173B60" CornerRadius="3" Padding="3,1"><TextBlock Text="Ctrl+F" FontSize="10"/></Border></StackPanel></Button>
            <Button Classes="secondary toolAction" Content="{}{ }  Định dạng" Click="Format_OnClick" ToolTip.Tip="Ctrl + Shift + F"/>
            <Button Classes="secondary toolAction" Content="✓  Kiểm tra cú pháp" Click="Validate_OnClick"/>
            <Button x:Name="ExpandEditorButton" Classes="secondary toolAction" Content="⛶  Toàn màn hình" Click="Expand_OnClick" ToolTip.Tip="F11"/>
          </StackPanel>
          <Grid x:Name="EditorSearchBar" Grid.Row="1" IsVisible="False" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6" Margin="0,4,0,8"><TextBox x:Name="EditorSearchText" PlaceholderText="Tìm trong JSON…" KeyDown="Search_OnKeyDown"/><TextBlock x:Name="EditorSearchStatus" Grid.Column="1" VerticalAlignment="Center"/><Button Grid.Column="2" Classes="secondary toolAction" Content="Tìm tiếp" Click="FindNext_OnClick"/><Button Grid.Column="3" Classes="secondary toolAction" Content="✕" Click="CloseSearch_OnClick"/></Grid>
          <StackPanel Grid.Row="2" x:Name="RiskInputs" IsVisible="False" Spacing="6" Margin="0,5">
            <TextBlock Text="Ước tính trước chi phí; nhập thông số hợp đồng từ broker." Classes="dim" TextWrapping="Wrap"/>
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6"><TextBox x:Name="RiskBudget" Text="100" PlaceholderText="Risk USD"/><TextBox Grid.Column="1" x:Name="RiskDistance" Text="5" PlaceholderText="Khoảng SL"/><TextBox Grid.Column="2" x:Name="RiskTickSize" Text="0.01" PlaceholderText="Tick size"/><TextBox Grid.Column="3" x:Name="RiskTickValue" Text="1" PlaceholderText="Tick value/lot"/></Grid>
            <Button Classes="primary" Content="Tính lot theo mức rủi ro" Click="CalculateRisk_OnClick"/>
          </StackPanel>
          <StackPanel Grid.Row="2" x:Name="HistoryInputs" IsVisible="False" Spacing="6" Margin="0,5">
            <TextBlock Text="Tải nến đóng của 8 khung thời gian MT5 cung cấp. Tiến độ và giới hạn được lưu cùng CSV." FontSize="12" TextWrapping="Wrap"/>
            <Grid ColumnDefinitions="3*,*,Auto,Auto" ColumnSpacing="6">
              <TextBox x:Name="HistoryTerminal" Text="C:\Program Files\MetaTrader 5\terminal64.exe" FontSize="12"/>
              <TextBox Grid.Column="1" x:Name="HistorySymbol" Text="XAUUSD" FontSize="12"/>
              <Button Grid.Column="2" Classes="primary" Content="Tải lịch sử MT5" Click="HistoryStart_OnClick" FontSize="12"/>
              <Button Grid.Column="3" Classes="secondary" Content="Tiến độ" Click="HistoryStatus_OnClick" FontSize="12"/>
            </Grid>
          </StackPanel>
          <Grid Grid.Row="3" Grid.RowSpan="2" ColumnDefinitions="1.8*,1*" ColumnSpacing="7" Margin="0,6,0,0">
            <TextBox x:Name="ToolEditor" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="14" LineHeight="19" Padding="0" Background="#041321" Foreground="#E3EDF8" CaretBrush="#FFFFFF" SelectionBrush="#295B85" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" TextChanged="Editor_OnTextChanged">
              <TextBox.Template><ControlTemplate><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4"><Grid ColumnDefinitions="49,*">
                <Border Background="#061A2E" BorderBrush="#153751" BorderThickness="0,0,1,0" ClipToBounds="True"><ScrollViewer x:Name="PART_GutterScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" IsHitTestVisible="False"><TextBlock x:Name="PART_LineNumbers" FontFamily="Consolas" FontSize="14" LineHeight="19" Foreground="#B4BCD0" TextAlignment="Right" Padding="4,4,10,4"/></ScrollViewer></Border>
                <ScrollViewer Grid.Column="1" x:Name="PART_ScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="4,4,0,4">
                  <local:JsonSyntaxPresenter x:Name="PART_TextPresenter" Text="{TemplateBinding Text, Mode=TwoWay}" CaretIndex="{TemplateBinding CaretIndex}" SelectionStart="{TemplateBinding SelectionStart}" SelectionEnd="{TemplateBinding SelectionEnd}" SelectionBrush="{TemplateBinding SelectionBrush}" SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}" CaretBrush="{TemplateBinding CaretBrush}" CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}" TextWrapping="NoWrap" LineHeight="{TemplateBinding LineHeight}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                </ScrollViewer>
              </Grid></Border></ControlTemplate></TextBox.Template>
            </TextBox>
            <Grid Grid.Column="1" RowDefinitions="*,Auto" RowSpacing="9">
              <Border Classes="panelSoft" Padding="10"><StackPanel Spacing="6"><TextBlock Text="Thông tin file" Classes="panelTitle"/><Border BorderBrush="#143750" BorderThickness="1" CornerRadius="4" Padding="7"><StackPanel Spacing="5"><Grid ColumnDefinitions="94,*"><TextBlock Text="Nguồn" FontSize="14"/><TextBlock Grid.Column="1" Text="Profile từ Engine" FontSize="14"/></Grid><Border Height="1" Background="#10314A"/><TextBlock x:Name="EditorFileInfo" Text="Chờ nạp dữ liệu" FontSize="14" TextWrapping="Wrap" LineHeight="23"/><Border Height="1" Background="#10314A"/><TextBlock Text="Định dạng       JSON" FontSize="14"/><TextBlock x:Name="EditorValidation" Text="●  Chưa kiểm tra" Foreground="#FFD34D" TextWrapping="Wrap" FontSize="14"/></StackPanel></Border></StackPanel></Border>
              <Border Grid.Row="1" Classes="panelSoft" Padding="10"><Grid RowDefinitions="Auto,45,45,47" ColumnDefinitions="*,*" RowSpacing="8" ColumnSpacing="8"><TextBlock Text="Thao tác nhanh" Classes="panelTitle" Grid.ColumnSpan="2"/>
                <Button Grid.Row="1" x:Name="SaveProfileButton" Classes="primary toolAction" Height="45" Content="▣  Lưu bản nháp" Click="Save_OnClick" ToolTip.Tip="Lưu JSON ra file • Ctrl+S. Dùng Áp dụng vào hệ thống để đổi cấu hình đang chạy."/>
                <Button Grid.Row="1" Grid.Column="1" Classes="secondary toolAction" Height="45" Content="▤  Lưu thành…" Click="Save_OnClick"/>
                <Button Grid.Row="2" Classes="secondary toolAction" Height="45" Content="↻  Tải lại" Click="Reload_OnClick"/>
                <Button Grid.Row="2" Grid.Column="1" x:Name="DefaultProfileButton" Classes="secondary toolAction" Height="45" Content="↶  Mặc định" Click="Defaults_OnClick"/>
                <Button Grid.Row="3" Grid.ColumnSpan="2" x:Name="ApplyToolButton" Height="47" Background="#00613E" BorderBrush="#19DA8F" Content="▷  Áp dụng vào hệ thống" Click="Apply_OnClick" HorizontalAlignment="Stretch" FontSize="14"/>
              </Grid></Border>
            </Grid>
          </Grid>
        </Grid>
      </Border>
      <Border Grid.Row="3" Classes="panel" Padding="10,5"><Grid RowDefinitions="Auto,*"><TextBlock Text="Kết quả kiểm tra" Classes="panelTitle"/><Grid Grid.Row="1" ColumnDefinitions="48,*,180" ColumnSpacing="12" Margin="2,9,0,0"><Border x:Name="ToolResultBadge" Background="#135A7B" Width="42" Height="42" CornerRadius="24" VerticalAlignment="Center"><TextBlock x:Name="ToolResultIcon" Text="i" FontSize="26" Foreground="#042034" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock x:Name="ToolResult" Text="Chờ Python Engine sẵn sàng." Foreground="#94CCFF" TextWrapping="Wrap" FontSize="16"/><TextBlock x:Name="ToolResultDetail" Text="Kiểm tra cấu hình trước khi áp dụng." FontSize="14" Foreground="#C0D8EB" TextWrapping="Wrap"/></StackPanel><TextBlock x:Name="ToolResultMeta" Grid.Column="2" FontSize="13" TextAlignment="Right" VerticalAlignment="Center" TextWrapping="Wrap"/></Grid></Grid></Border>
    </Grid>
    <Grid x:Name="ToolHelpColumn" Grid.Column="2" RowDefinitions="320,232,*" RowSpacing="8">
      <Border Classes="panel" Padding="12"><StackPanel Spacing="10"><TextBlock Text="Công cụ đã chọn" Classes="panelTitle"/><Grid ColumnDefinitions="58,*" ColumnSpacing="12"><Border Background="#072644" CornerRadius="5" Padding="3"><local:ReferenceIcon x:Name="SelectedToolIcon" Kind="document" Width="47" Height="47" Tint="#21A8FF"/></Border><TextBlock Grid.Column="1" x:Name="SelectedToolName" Text="Trình chỉnh sửa cấu hình" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/></Grid><TextBlock x:Name="SelectedToolDescription" Text="Chỉnh sửa, kiểm tra và quản lý các file cấu hình của EA, chiến lược và hệ thống." TextWrapping="Wrap"/><TextBlock Text="Tính năng chính:"/><TextBlock Text="✔  Chỉnh sửa trực tiếp với tô màu cú pháp&#10;✔  Kiểm tra cú pháp JSON / schema&#10;✔  Sao lưu và khôi phục nhanh&#10;✔  Áp dụng cấu hình vào hệ thống&#10;✔  Execution luôn được khóa" Foreground="#43ECA6" LineHeight="25" FontSize="14" TextWrapping="Wrap"/></StackPanel></Border>
      <Border Grid.Row="1" Classes="panel" Padding="12"><StackPanel Spacing="10"><TextBlock Text="◉  Mẹo nhanh" Classes="panelTitle"/><Grid ColumnDefinitions="112,*" RowDefinitions="25,25,25,25" RowSpacing="5"><Border Background="#103456" CornerRadius="4" Padding="5,1"><TextBlock Text="Ctrl + S" FontSize="13"/></Border><TextBlock Grid.Column="1" Text="Lưu cấu hình" FontSize="14" Margin="10,0,0,0"/><Border Grid.Row="1" Background="#103456" CornerRadius="4" Padding="5,1"><TextBlock Text="Ctrl + F" FontSize="13"/></Border><TextBlock Grid.Row="1" Grid.Column="1" Text="Tìm kiếm trong file" FontSize="14" Margin="10,0,0,0"/><Border Grid.Row="2" Background="#103456" CornerRadius="4" Padding="5,1"><TextBlock Text="Ctrl + Shift + F" FontSize="13"/></Border><TextBlock Grid.Row="2" Grid.Column="1" Text="Định dạng JSON" FontSize="14" Margin="10,0,0,0"/><Border Grid.Row="3" Background="#103456" CornerRadius="4" Padding="5,1"><TextBlock Text="F11" FontSize="13"/></Border><TextBlock Grid.Row="3" Grid.Column="1" Text="Toàn màn hình" FontSize="14" Margin="10,0,0,0"/></Grid><Button Classes="secondary toolAction" Content="▤  Mở file cấu hình…" Click="Open_OnClick" HorizontalAlignment="Left"/></StackPanel></Border>
      <Border Grid.Row="2" Classes="panel" Padding="10"><Grid RowDefinitions="Auto,*"><TextBlock Text="Lịch sử thao tác" Classes="panelTitle"/><ScrollViewer Grid.Row="1" Margin="0,10,0,0"><TextBlock x:Name="ToolHistory" FontSize="14" TextWrapping="Wrap" LineHeight="25"/></ScrollViewer></Grid></Border>
    </Grid>
  </Grid>
</UserControl>
