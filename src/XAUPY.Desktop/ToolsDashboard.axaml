<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:XAUPY.Desktop" x:Class="XAUPY.Desktop.ToolsDashboard" KeyDown="Tools_OnKeyDown">
  <UserControl.Styles>
    <Style Selector="Button.toolAction"><Setter Property="FontSize" Value="{DynamicResource Font_13}"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="10,5"/></Style>
    <Style Selector="TextBox.toolField"><Setter Property="Height" Value="36"/><Setter Property="FontSize" Value="{DynamicResource Font_14}"/></Style>
  </UserControl.Styles>
  <Grid x:Name="ToolsLayout" ColumnDefinitions="330,*,320" ColumnSpacing="9">
    <Border x:Name="ToolNavigation" Classes="panel" Padding="7">
      <Grid RowDefinitions="Auto,*">
        <StackPanel Margin="5,0,0,14" Spacing="5">
          <TextBlock Text="{DynamicResource Text_3499d617b377d679}" FontSize="{DynamicResource Font_20}" FontWeight="SemiBold" Foreground="{DynamicResource Brush_C8E4FF}"/>
          <TextBlock Text="{DynamicResource Text_b2393e6ba660a786}" TextWrapping="Wrap" FontSize="{DynamicResource Font_14}"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1"><StackPanel Spacing="4" x:Name="ToolMenu">
          <Button Classes="secondary" Tag="editor" Click="SelectTool_OnClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="{DynamicResource Text_54fb4b2e456fd4aa}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Text_731653ed81d6f9fa}" FontSize="{DynamicResource Font_13}"/></StackPanel></Button>
          <Button Classes="secondary" Tag="compare" Click="SelectTool_OnClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="{DynamicResource Text_3b135c5c3c475061}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Text_9a2c0560d9ed8655}" FontSize="{DynamicResource Font_13}"/></StackPanel></Button>
          <Button Classes="secondary" Tag="indicators" Click="SelectTool_OnClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="{DynamicResource Text_42cf840fbfda1da8}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Text_75c0724b895ba22b}" FontSize="{DynamicResource Font_13}"/></StackPanel></Button>
          <Button Classes="secondary" Tag="risk" Click="SelectTool_OnClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="{DynamicResource Text_9a7320d0dca98337}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Text_40c7e5f8f38f7ee3}" FontSize="{DynamicResource Font_13}"/></StackPanel></Button>
          <Button Classes="secondary" Tag="symbol" Click="SelectTool_OnClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="{DynamicResource Text_6331cf778aea1154}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Text_7066042a492610a6}" FontSize="{DynamicResource Font_13}"/></StackPanel></Button>
          <Button Classes="secondary" Tag="news" Click="SelectTool_OnClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="{DynamicResource Text_97b80c829b328bc5}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Text_3294ab26b17a4b92}" FontSize="{DynamicResource Font_13}"/></StackPanel></Button>
          <Button Classes="secondary" Tag="diagnostics" Click="SelectTool_OnClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="{DynamicResource Text_cbd8dda133bfb096}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Text_681cc6c98e9e3d16}" FontSize="{DynamicResource Font_13}"/></StackPanel></Button>
          <Button Classes="secondary" Tag="bridge" Click="SelectTool_OnClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="{DynamicResource Text_9fdded3d53bcf354}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Text_13c6a97096aeaad4}" FontSize="{DynamicResource Font_13}"/></StackPanel></Button>
          <Button Classes="secondary" Tag="profile" Click="SelectTool_OnClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="{DynamicResource Text_6dbff3260333c47b}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Text_9aa65dfbef7b5a8c}" FontSize="{DynamicResource Font_13}"/></StackPanel></Button>
          <Button Classes="secondary" Tag="export" Click="SelectTool_OnClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="{DynamicResource Text_19fa9d1f7eff56ef}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Text_eca89b6d84eb3fce}" FontSize="{DynamicResource Font_13}"/></StackPanel></Button>
        </StackPanel></ScrollViewer>
      </Grid>
    </Border>
    <Grid x:Name="ToolWorkspace" Grid.Column="1" RowDefinitions="86,74,*,112" RowSpacing="8">
      <Border Classes="panel" Padding="16,10"><Grid ColumnDefinitions="62,*,150" ColumnSpacing="14"><local:ReferenceIcon x:Name="ToolHeaderIcon" Kind="document" Width="49" Height="49" Tint="{DynamicResource Brush_21A8FF}"/><StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center"><TextBlock x:Name="ToolTitle" Text="{local:InitialText 54fb4b2e456fd4aa}" FontSize="{DynamicResource Font_24}" FontWeight="SemiBold" Foreground="{DynamicResource Brush_B8E0FF}"/><TextBlock x:Name="ToolSubtitle" Text="{local:InitialText af17bff786c5cbdb}" FontSize="{DynamicResource Font_14}" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="2" Classes="secondary" Height="42" VerticalAlignment="Top" Click="Help_OnClick"><StackPanel Orientation="Horizontal" Spacing="10"><local:ReferenceIcon Kind="book" Width="22" Height="22"/><TextBlock Text="{DynamicResource Text_986946214dd5bb9e}" VerticalAlignment="Center"/></StackPanel></Button></Grid></Border>
      <Grid Grid.Row="1" ColumnDefinitions="1.4*,40,1.1*,1*,1.3*" ColumnSpacing="12" Margin="12,1">
        <StackPanel Spacing="5"><TextBlock Text="{DynamicResource Text_5c60626b450b20fd}"/><TextBox Classes="toolField" x:Name="ToolFileName" Text="active-profile.json" IsReadOnly="True"/></StackPanel>
        <Button Grid.Column="1" Classes="secondary" Height="36" VerticalAlignment="Bottom" Margin="0,0,0,6" Click="Reload_OnClick" ToolTip.Tip="{DynamicResource Text_248874316eab5b03}" Padding="7"><local:ReferenceIcon Kind="refresh" Width="23" Height="23"/></Button>
        <StackPanel Grid.Column="2" Spacing="5"><TextBlock Text="{DynamicResource Text_523f8059a0ae022a}"/><TextBox x:Name="ConfigScopeReadOnly" Text="EA / Trading" IsReadOnly="True" Height="36" ToolTip.Tip="Hồ sơ cấu hình chiến lược EA/Python đang hỗ trợ; không phải bộ chọn chế độ giao dịch."/></StackPanel>
        <StackPanel Grid.Column="3" Spacing="5"><TextBlock Text="Symbol"/><TextBox Classes="toolField" x:Name="ToolSymbol" Text="—" IsReadOnly="True"/></StackPanel>
        <StackPanel Grid.Column="4" Spacing="5"><TextBlock Text="{DynamicResource Text_f5e71f4689fbaa1f}"/><TextBox Classes="toolField" x:Name="ToolProfileName" Text="—" IsReadOnly="True"/></StackPanel>
      </Grid>
      <Border Grid.Row="2" Classes="panel" Padding="8">
        <Grid RowDefinitions="40,Auto,Auto,*,Auto" RowSpacing="0">
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
            <Button Classes="secondary toolAction" Click="Find_OnClick"><StackPanel Orientation="Horizontal" Spacing="7"><local:ReferenceIcon Kind="search" Width="20" Height="20"/><TextBlock Text="{DynamicResource Text_87ae432c9f654c1e}" VerticalAlignment="Center"/><Border Background="{DynamicResource Brush_173B60}" CornerRadius="3" Padding="3,1"><TextBlock Text="Ctrl+F" FontSize="{DynamicResource Font_10}"/></Border></StackPanel></Button>
            <Button Classes="secondary toolAction" Content="{DynamicResource Text_e4b7995dd4df108a}" Click="Format_OnClick" ToolTip.Tip="Ctrl + Shift + F"/>
            <Button Classes="secondary toolAction" Content="{DynamicResource Text_72134d67c0b17ebd}" Click="Validate_OnClick"/>
            <Button x:Name="ExpandEditorButton" Classes="secondary toolAction" Content="{DynamicResource Text_dfcf4468ef3e693f}" Click="Expand_OnClick" ToolTip.Tip="F11"/>
          </StackPanel>
          <Grid x:Name="EditorSearchBar" Grid.Row="1" IsVisible="False" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6" Margin="0,4,0,8"><TextBox x:Name="EditorSearchText" PlaceholderText="{DynamicResource Text_69b101d30d89cd8f}" KeyDown="Search_OnKeyDown"/><TextBlock x:Name="EditorSearchStatus" Grid.Column="1" VerticalAlignment="Center"/><Button Grid.Column="2" Classes="secondary toolAction" Content="{DynamicResource Text_26ee6e2d24b01ecc}" Click="FindNext_OnClick"/><Button Grid.Column="3" Classes="secondary toolAction" Content="✕" Click="CloseSearch_OnClick"/></Grid>
          <StackPanel Grid.Row="2" x:Name="RiskInputs" IsVisible="False" Spacing="6" Margin="0,5">
            <TextBlock Text="{DynamicResource Text_329cb4fcbd0bcd8f}" Classes="dim" TextWrapping="Wrap"/>
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
              <StackPanel Spacing="4"><TextBlock Text="{DynamicResource Text_6bd9d4d0b38a9917}" TextWrapping="Wrap"/><TextBox x:Name="RiskBudget" Text="100"/></StackPanel>
              <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{DynamicResource Text_85ec04a658f9b473}" TextWrapping="Wrap"/><TextBox x:Name="RiskDistance" Text="5"/></StackPanel>
              <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="{DynamicResource Text_a4105d5efec7fa9f}" TextWrapping="Wrap"/><TextBox x:Name="RiskTickSize" Text="0.01"/></StackPanel>
              <StackPanel Grid.Column="3" Spacing="4"><TextBlock Text="{DynamicResource Text_9ad4a5ce02bca72c}" TextWrapping="Wrap"/><TextBox x:Name="RiskTickValue" Text="1"/></StackPanel>
            </Grid>
            <Button Classes="primary" Content="{DynamicResource Text_ba189c6d55f2bcbb}" Click="CalculateRisk_OnClick"/>
          </StackPanel>
          <WrapPanel Grid.Row="2" x:Name="LibraryInputs" IsVisible="False" Orientation="Horizontal" Margin="0,5">
            <TextBox x:Name="LibraryProfileId" Text="my-profile" Width="160" PlaceholderText="{DynamicResource Text_78f88da024d1c962}"/>
            <Button Classes="secondary" Content="{DynamicResource Text_32f1c93f25221869}" Click="SaveLibrary_OnClick"/>
            <Button Classes="secondary" Content="{DynamicResource Text_e7d11849cea48274}" Click="OpenLibrary_OnClick"/>
            <Button Classes="secondary" Content="{DynamicResource Text_e4e18b9918779e7e}" Click="ClearStartup_OnClick"/>
          </WrapPanel>
          <StackPanel Grid.Row="2" x:Name="CompareInputs" IsVisible="False" Orientation="Horizontal" Spacing="6" Margin="0,5">
            <Button Classes="secondary" Content="{DynamicResource Text_f56fbb83ceb20bc6}" Click="CompareFiles_OnClick"/>
          </StackPanel>
          <StackPanel Grid.Row="2" x:Name="HistoryInputs" IsVisible="False" Spacing="6" Margin="0,5">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="{DynamicResource Text_fef6e03701b80c31}" Tag="EXPORT" Click="DataTransfer_OnClick"/>
              <Button Content="{DynamicResource Text_4c45ec1b91e57e9c}" Tag="IMPORT" Click="DataTransfer_OnClick"/>
              <Button Content="{DynamicResource Text_9245be589af94d31}" Click="DataTransferStatus_OnClick"/>
              <Button Content="{DynamicResource Text_74fcd3522be7e175}" Click="DataTransferCancel_OnClick"/>
            </StackPanel>
            <TextBlock Text="{DynamicResource Text_bbe9437a6a7285de}" FontSize="{DynamicResource Font_12}" TextWrapping="Wrap"/>
            <Grid ColumnDefinitions="3*,*,Auto,Auto" ColumnSpacing="6">
              <TextBox x:Name="HistoryTerminal" Text="C:\Program Files\MetaTrader 5\terminal64.exe" FontSize="{DynamicResource Font_12}"/>
              <TextBox Grid.Column="1" x:Name="HistorySymbol" Text="XAUUSD" FontSize="{DynamicResource Font_12}"/>
              <Button Grid.Column="2" Classes="primary" Content="{DynamicResource Text_ae4c5f29c2b3e316}" Click="HistoryStart_OnClick" FontSize="{DynamicResource Font_12}"/>
              <Button Grid.Column="3" Classes="secondary" Content="{DynamicResource Text_e59478450504f4b8}" Click="HistoryStatus_OnClick" FontSize="{DynamicResource Font_12}"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <DatePicker x:Name="TickFromDate" ToolTip.Tip="{DynamicResource Text_4df0408f8fa8cc48}"/>
              <DatePicker x:Name="TickToDate" ToolTip.Tip="{DynamicResource Text_fa34c5af771b00ed}"/>
              <Button Classes="secondary" Content="{DynamicResource Text_d2f8f7f292981fa5}" Click="TickHistoryStart_OnClick"/>
            </StackPanel>
            <TextBlock Text="{DynamicResource Text_d527a868c3a8eb84}" FontSize="{DynamicResource Font_11}" TextWrapping="Wrap"/>
          </StackPanel>
          <Grid Grid.Row="3" Grid.RowSpan="2" ColumnDefinitions="1.8*,1*" ColumnSpacing="7" Margin="0,6,0,0">
            <TextBox x:Name="ToolEditor" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="{DynamicResource Font_14}" LineHeight="19" Padding="0" Background="{DynamicResource Brush_041321}" Foreground="{DynamicResource Brush_E3EDF8}" CaretBrush="{DynamicResource Brush_FFFFFF}" SelectionBrush="{DynamicResource Brush_295B85}" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" TextChanged="Editor_OnTextChanged">
              <TextBox.Template><ControlTemplate><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4"><Grid ColumnDefinitions="49,*">
                <Border Background="{DynamicResource Brush_061A2E}" BorderBrush="{DynamicResource Brush_153751}" BorderThickness="0,0,1,0" ClipToBounds="True"><ScrollViewer x:Name="PART_GutterScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" IsHitTestVisible="False"><TextBlock x:Name="PART_LineNumbers" FontFamily="Consolas" FontSize="{DynamicResource Font_14}" LineHeight="19" Foreground="{DynamicResource Brush_B4BCD0}" TextAlignment="Right" Padding="4,4,10,4"/></ScrollViewer></Border>
                <ScrollViewer Grid.Column="1" x:Name="PART_ScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="4,4,0,4">
                  <local:JsonSyntaxPresenter x:Name="PART_TextPresenter" Text="{TemplateBinding Text, Mode=TwoWay}" CaretIndex="{TemplateBinding CaretIndex}" SelectionStart="{TemplateBinding SelectionStart}" SelectionEnd="{TemplateBinding SelectionEnd}" SelectionBrush="{TemplateBinding SelectionBrush}" SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}" CaretBrush="{TemplateBinding CaretBrush}" CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}" TextWrapping="NoWrap" LineHeight="{TemplateBinding LineHeight}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                </ScrollViewer>
              </Grid></Border></ControlTemplate></TextBox.Template>
            </TextBox>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel Spacing="9">
              <Border Classes="panelSoft" Padding="10"><StackPanel Spacing="6"><TextBlock Text="{DynamicResource Text_e621701cf5b1e362}" Classes="panelTitle"/><Border BorderBrush="{DynamicResource Brush_143750}" BorderThickness="1" CornerRadius="4" Padding="7"><StackPanel Spacing="5"><Grid ColumnDefinitions="94,*"><TextBlock Text="{DynamicResource Text_c76d57b348bd2310}" FontSize="{DynamicResource Font_14}"/><TextBlock Grid.Column="1" Text="{DynamicResource Text_e5afd6473fffc778}" FontSize="{DynamicResource Font_14}"/></Grid><Border Height="1" Background="{DynamicResource Brush_10314A}"/><TextBlock x:Name="EditorFileInfo" Text="{local:InitialText 220d29b837633da8}" FontSize="{DynamicResource Font_14}" TextWrapping="Wrap" LineHeight="23"/><Border Height="1" Background="{DynamicResource Brush_10314A}"/><TextBlock Text="{DynamicResource Text_6e47e82686b79cf1}" FontSize="{DynamicResource Font_14}"/><TextBlock x:Name="EditorValidation" Text="{local:InitialText 5f8e0cfb6014c5dd}" Foreground="{DynamicResource Brush_FFD34D}" TextWrapping="Wrap" FontSize="{DynamicResource Font_14}"/></StackPanel></Border></StackPanel></Border>
              <Border Grid.Row="1" Classes="panelSoft" Padding="10"><Grid RowDefinitions="Auto,45,45,47" ColumnDefinitions="*,*" RowSpacing="8" ColumnSpacing="8"><TextBlock Text="{DynamicResource Text_f3cc76b2c772967f}" Classes="panelTitle" Grid.ColumnSpan="2"/>
                <Button Grid.Row="1" x:Name="SaveProfileButton" Classes="primary toolAction" Height="45" Content="{DynamicResource Text_a7fbbca0a910c5bc}" Click="Save_OnClick" ToolTip.Tip="{DynamicResource Text_5830bd73b41d31f1}"/>
                <Button Grid.Row="1" Grid.Column="1" Classes="secondary toolAction" Height="45" Content="{DynamicResource Text_dcaeed7d6b707ff8}" Tag="save-as" Click="Save_OnClick"/>
                <Button Grid.Row="2" Classes="secondary toolAction" Height="45" Content="{DynamicResource Text_db3f0c0589163588}" Click="Reload_OnClick"/>
                <Button Grid.Row="2" Grid.Column="1" x:Name="DefaultProfileButton" Classes="secondary toolAction" Height="45" Content="{DynamicResource Text_5dc488857b5855d9}" Click="Defaults_OnClick"/>
                <Button Grid.Row="3" Grid.ColumnSpan="2" x:Name="ApplyToolButton" Height="47" Background="{DynamicResource Brush_00613E}" BorderBrush="{DynamicResource Brush_19DA8F}" Content="{DynamicResource Text_74f5c7f800731d34}" Click="Apply_OnClick" HorizontalAlignment="Stretch" FontSize="{DynamicResource Font_14}"/>
              </Grid></Border>
            </StackPanel></ScrollViewer>
          </Grid>
        </Grid>
      </Border>
      <Border Grid.Row="3" Classes="panel" Padding="10,5"><Grid RowDefinitions="Auto,*"><TextBlock Text="{DynamicResource Text_ee1a26f94d3fba2d}" Classes="panelTitle"/><Grid Grid.Row="1" ColumnDefinitions="48,*,180" ColumnSpacing="12" Margin="2,9,0,0"><Border x:Name="ToolResultBadge" Background="{DynamicResource Brush_135A7B}" Width="42" Height="42" CornerRadius="24" VerticalAlignment="Center"><TextBlock x:Name="ToolResultIcon" Text="i" FontSize="{DynamicResource Font_26}" Foreground="{DynamicResource Brush_042034}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock x:Name="ToolResult" Text="{local:InitialText b1239ed0a8503f6d}" Foreground="{DynamicResource Brush_94CCFF}" TextWrapping="Wrap" FontSize="{DynamicResource Font_16}"/><TextBlock x:Name="ToolResultDetail" Text="{local:InitialText 63548597c21a87a9}" FontSize="{DynamicResource Font_14}" Foreground="{DynamicResource Brush_C0D8EB}" TextWrapping="Wrap"/></StackPanel><TextBlock x:Name="ToolResultMeta" Grid.Column="2" FontSize="{DynamicResource Font_13}" TextAlignment="Right" VerticalAlignment="Center" TextWrapping="Wrap"/></Grid></Grid></Border>
    </Grid>
    <Grid x:Name="ToolHelpColumn" Grid.Column="2" RowDefinitions="320,232,*" RowSpacing="8">
      <Border Classes="panel" Padding="12"><StackPanel Spacing="10"><TextBlock Text="{DynamicResource Text_c6f79c1a4d458e5b}" Classes="panelTitle"/><Grid ColumnDefinitions="58,*" ColumnSpacing="12"><Border Background="{DynamicResource Brush_072644}" CornerRadius="5" Padding="3"><local:ReferenceIcon x:Name="SelectedToolIcon" Kind="document" Width="47" Height="47" Tint="{DynamicResource Brush_21A8FF}"/></Border><TextBlock Grid.Column="1" x:Name="SelectedToolName" Text="{local:InitialText 54fb4b2e456fd4aa}" FontSize="{DynamicResource Font_18}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/></Grid><TextBlock x:Name="SelectedToolDescription" Text="{local:InitialText 8388941960726f2d}" TextWrapping="Wrap"/><TextBlock Text="{DynamicResource Text_740a236889b3b756}"/><TextBlock x:Name="SelectedToolCapabilities" Text="{local:InitialText 40af6a6fb0f6ec3c}" Foreground="{DynamicResource Brush_43ECA6}" LineHeight="25" FontSize="{DynamicResource Font_14}" TextWrapping="Wrap"/></StackPanel></Border>
      <Border Grid.Row="1" Classes="panel" Padding="12"><StackPanel Spacing="10"><TextBlock Text="{DynamicResource Text_917be122aa534c14}" Classes="panelTitle"/><Grid ColumnDefinitions="112,*" RowDefinitions="25,25,25,25" RowSpacing="5"><Border Background="{DynamicResource Brush_103456}" CornerRadius="4" Padding="5,1"><TextBlock Text="Ctrl + S" FontSize="{DynamicResource Font_13}"/></Border><TextBlock Grid.Column="1" Text="{DynamicResource Text_5df37315694e88a2}" FontSize="{DynamicResource Font_14}" Margin="10,0,0,0"/><Border Grid.Row="1" Background="{DynamicResource Brush_103456}" CornerRadius="4" Padding="5,1"><TextBlock Text="Ctrl + F" FontSize="{DynamicResource Font_13}"/></Border><TextBlock Grid.Row="1" Grid.Column="1" Text="{DynamicResource Text_51f67f928c9d647a}" FontSize="{DynamicResource Font_14}" Margin="10,0,0,0"/><Border Grid.Row="2" Background="{DynamicResource Brush_103456}" CornerRadius="4" Padding="5,1"><TextBlock Text="Ctrl + Shift + F" FontSize="{DynamicResource Font_13}"/></Border><TextBlock Grid.Row="2" Grid.Column="1" Text="{DynamicResource Text_8815d39b987d62f9}" FontSize="{DynamicResource Font_14}" Margin="10,0,0,0"/><Border Grid.Row="3" Background="{DynamicResource Brush_103456}" CornerRadius="4" Padding="5,1"><TextBlock Text="F11" FontSize="{DynamicResource Font_13}"/></Border><TextBlock Grid.Row="3" Grid.Column="1" Text="{DynamicResource Text_ebe2ccb4a480f518}" FontSize="{DynamicResource Font_14}" Margin="10,0,0,0"/></Grid><Button Classes="secondary toolAction" Content="{DynamicResource Text_ba9c3e558dbdd2ac}" Click="Open_OnClick" HorizontalAlignment="Left"/></StackPanel></Border>
      <Border Grid.Row="2" Classes="panel" Padding="10"><Grid RowDefinitions="Auto,*"><TextBlock Text="{DynamicResource Text_58ce82b99ccdbd6d}" Classes="panelTitle"/><ScrollViewer Grid.Row="1" Margin="0,10,0,0"><TextBlock x:Name="ToolHistory" FontSize="{DynamicResource Font_14}" TextWrapping="Wrap" LineHeight="25"/></ScrollViewer></Grid></Border>
    </Grid>
  </Grid>
</UserControl>
