<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="XAUPY.Desktop.ToolsDashboard">
  <Grid ColumnDefinitions="330,*,320" ColumnSpacing="9">
    <Border Classes="panel" Padding="7">
      <Grid RowDefinitions="Auto,*">
        <StackPanel Margin="5,0,0,10" Spacing="5">
          <TextBlock Text="Trung tâm công cụ" FontSize="20" FontWeight="SemiBold" Foreground="#C8E4FF"/>
          <TextBlock Text="Bộ công cụ hỗ trợ vận hành, kiểm tra và quản lý hệ thống" TextWrapping="Wrap" FontSize="12"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1"><StackPanel Spacing="4" x:Name="ToolMenu">
          <Button Classes="secondary" Tag="editor" Click="SelectTool_OnClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="▤   Trình chỉnh sửa cấu hình" FontWeight="SemiBold"/><TextBlock Text="      Sửa file config, tham số EA, chiến lược" FontSize="11"/></StackPanel></Button>
          <Button Classes="secondary" Tag="compare" Click="SelectTool_OnClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="⇄   So sánh Preset" FontWeight="SemiBold"/><TextBlock Text="      So sánh profile đang chạy với mặc định" FontSize="11"/></StackPanel></Button>
          <Button Classes="secondary" Tag="indicators" Click="SelectTool_OnClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="▥   Kiểm tra chỉ báo" FontWeight="SemiBold"/><TextBlock Text="      Probe indicator, tín hiệu và dữ liệu" FontSize="11"/></StackPanel></Button>
          <Button Classes="secondary" Tag="risk" Click="SelectTool_OnClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="▦   Tính toán rủi ro" FontWeight="SemiBold"/><TextBlock Text="      Khoảng SL, tick value và lot size" FontSize="11"/></StackPanel></Button>
          <Button Classes="secondary" Tag="symbol" Click="SelectTool_OnClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="◎   Thông tin Symbol &amp; Phiên" FontWeight="SemiBold"/><TextBlock Text="      Thông số giao dịch, spread, phiên" FontSize="11"/></StackPanel></Button>
          <Button Classes="secondary" Tag="news" Click="SelectTool_OnClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="▤   Kiểm tra file tin tức" FontWeight="SemiBold"/><TextBlock Text="      Kiểm tra lịch tin JSON từ máy" FontSize="11"/></StackPanel></Button>
          <Button Classes="secondary" Tag="diagnostics" Click="SelectTool_OnClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="⌁   Chẩn đoán hệ thống" FontWeight="SemiBold"/><TextBlock Text="      Kiểm tra môi trường, log, kết nối" FontSize="11"/></StackPanel></Button>
          <Button Classes="secondary" Tag="bridge" Click="SelectTool_OnClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="↗   Kiểm tra kết nối Bridge" FontWeight="SemiBold"/><TextBlock Text="      Test kết nối EA Bridge ↔ Python" FontSize="11"/></StackPanel></Button>
          <Button Classes="secondary" Tag="profile" Click="SelectTool_OnClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="♙   Quản lý hồ sơ (Profile)" FontWeight="SemiBold"/><TextBlock Text="      Lưu, tải, sao lưu cấu hình" FontSize="11"/></StackPanel></Button>
          <Button Classes="secondary" Tag="export" Click="SelectTool_OnClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="⇅   Xuất / Nhập dữ liệu" FontWeight="SemiBold"/><TextBlock Text="      Xuất báo cáo, nhập cấu hình JSON" FontSize="11"/></StackPanel></Button>
        </StackPanel></ScrollViewer>
      </Grid>
    </Border>
    <Grid Grid.Column="1" RowDefinitions="78,68,*,96" RowSpacing="8">
      <Border Classes="panel" Padding="16,10"><StackPanel Spacing="5"><TextBlock x:Name="ToolTitle" Text="▤  Trình chỉnh sửa cấu hình" FontSize="23" Foreground="#A5D8FF"/><TextBlock x:Name="ToolSubtitle" Text="Chỉnh sửa cấu hình chuẩn; kiểm tra cú pháp và áp dụng nhanh." FontSize="12" TextWrapping="Wrap"/></StackPanel></Border>
      <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="10" Margin="12,1"><StackPanel Spacing="5"><TextBlock Text="Chọn file cấu hình"/><TextBox x:Name="ToolFileName" Text="active-profile.json" IsReadOnly="True"/></StackPanel><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="Loại cấu hình"/><TextBox Text="EA / Trading" IsReadOnly="True"/></StackPanel><StackPanel Grid.Column="2" Spacing="5"><TextBlock Text="Preset hiện tại"/><TextBox x:Name="ToolProfileName" Text="—" IsReadOnly="True"/></StackPanel></Grid>
      <Border Grid.Row="2" Classes="panel" Padding="8">
        <Grid RowDefinitions="40,Auto,*,Auto" RowSpacing="8">
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
            <Button Classes="secondary" Content="↻  Tải lại" Click="Reload_OnClick"/>
            <Button Classes="secondary" Content="{}{ }  Định dạng" Click="Format_OnClick"/>
            <Button Classes="secondary" Content="✓  Kiểm tra cú pháp" Click="Validate_OnClick"/>
          </StackPanel>
          <StackPanel Grid.Row="1" x:Name="RiskInputs" IsVisible="False" Spacing="6">
            <TextBlock Text="Ước tính trước chi phí; nhập thông số hợp đồng từ broker." Classes="dim" TextWrapping="Wrap"/>
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6"><TextBox x:Name="RiskBudget" Text="100" PlaceholderText="Risk USD"/><TextBox Grid.Column="1" x:Name="RiskDistance" Text="5" PlaceholderText="Khoảng SL"/><TextBox Grid.Column="2" x:Name="RiskTickSize" Text="0.01" PlaceholderText="Tick size"/><TextBox Grid.Column="3" x:Name="RiskTickValue" Text="1" PlaceholderText="Tick value/lot"/></Grid>
            <Button Classes="primary" Content="Tính lot theo mức rủi ro" Click="CalculateRisk_OnClick"/>
          </StackPanel>
          <Grid Grid.Row="2" Grid.RowSpan="2" ColumnDefinitions="1.8*,1*" ColumnSpacing="7">
            <TextBox x:Name="ToolEditor" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Cascadia Code,Consolas" FontSize="13" Background="#041321" Foreground="#75DEED" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            <Grid Grid.Column="1" RowDefinitions="*,Auto" RowSpacing="9">
              <Border Classes="panelSoft" Padding="10"><StackPanel Spacing="10"><TextBlock Text="Thông tin file" Classes="panelTitle"/><TextBlock Text="Nguồn cấu hình" FontSize="12"/><TextBlock Text="Python Engine / profile đang áp dụng" TextWrapping="Wrap" Foreground="#94C1E7" FontSize="12"/><TextBlock Text="Định dạng       JSON" FontSize="12"/><TextBlock x:Name="EditorFileInfo" Text="Chờ nạp dữ liệu" FontSize="12" TextWrapping="Wrap"/><TextBlock Text="●  Kiểm tra trước khi áp dụng" Foreground="#FFD34D" TextWrapping="Wrap" FontSize="12"/></StackPanel></Border>
              <Border Grid.Row="1" Classes="panelSoft" Padding="10"><StackPanel Spacing="8"><TextBlock Text="Thao tác nhanh" Classes="panelTitle"/>
                <Button Classes="primary" Content="▣  Lưu thành…" Click="Save_OnClick" HorizontalAlignment="Stretch" FontSize="12"/>
                <Button Classes="secondary" Content="▤  Mở file…" Click="Open_OnClick" HorizontalAlignment="Stretch" FontSize="12"/>
                <Button Classes="secondary" Content="↻  Tải lại từ Engine" Click="Reload_OnClick" HorizontalAlignment="Stretch" FontSize="12"/>
                <Button x:Name="ApplyToolButton" Background="#00613E" BorderBrush="#19DA8F" Content="▷  Áp dụng vào hệ thống" Click="Apply_OnClick" HorizontalAlignment="Stretch" FontSize="12"/>
              </StackPanel></Border>
            </Grid>
          </Grid>
        </Grid>
      </Border>
      <Border Grid.Row="3" Classes="panel" Padding="12"><StackPanel Spacing="8"><TextBlock Text="Kết quả kiểm tra" Classes="panelTitle"/><TextBlock x:Name="ToolResult" Text="Chờ Python Engine sẵn sàng." Foreground="#94CCFF" TextWrapping="Wrap"/></StackPanel></Border>
    </Grid>
    <Grid Grid.Column="2" RowDefinitions="245,180,*" RowSpacing="8">
      <Border Classes="panel" Padding="12"><StackPanel Spacing="12"><TextBlock Text="Công cụ đã chọn" Classes="panelTitle"/><TextBlock x:Name="SelectedToolName" Text="Trình chỉnh sửa cấu hình" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="SelectedToolDescription" Text="Kiểm tra và quản lý cấu hình của EA, chiến lược và hệ thống." TextWrapping="Wrap"/><TextBlock Text="✓ Kiểm tra schema canonical&#10;✓ Lưu cấu hình sau khi áp dụng&#10;✓ Sao lưu trước thay đổi&#10;✓ Guardian giữ execution locked" Foreground="#43ECA6" LineHeight="24" TextWrapping="Wrap"/></StackPanel></Border>
      <Border Grid.Row="1" Classes="panel" Padding="12"><StackPanel Spacing="10"><TextBlock Text="◉  Mẹo nhanh" Classes="panelTitle"/><TextBlock Text="Mở file để nạp profile từ máy.&#10;Định dạng giúp kiểm tra JSON.&#10;Áp dụng chỉ nhận schema hợp lệ.&#10;Báo cáo phản ánh dữ liệu thực.&#10;Sao lưu và khôi phục ở Cài đặt." TextWrapping="Wrap" LineHeight="24"/></StackPanel></Border>
      <Border Grid.Row="2" Classes="panel" Padding="10"><Grid RowDefinitions="Auto,*"><TextBlock Text="Lịch sử thao tác" Classes="panelTitle"/><ScrollViewer Grid.Row="1" Margin="0,10,0,0"><TextBlock x:Name="ToolHistory" FontSize="12" TextWrapping="Wrap" LineHeight="25"/></ScrollViewer></Grid></Border>
    </Grid>
  </Grid>
</UserControl>
